    /* ---------------- Kalkulator ---------------- */
    let currentTool=null, currentResult=null, history=[];
    function fieldVisible(f, vals){ return !f.showIf || f.showIf(vals); }
    function collectVals(tool){
      const vals={};
      tool.fields.forEach(f=>{
        const el = $("[name='"+f.id+"']", $("#calc-fields"));
        if(f.type==="seg"){ const on=$(".seg button.on[data-f='"+f.id+"']", $("#calc-fields")); vals[f.id]= on? on.dataset.v : f.def; }
        else if(!el){ vals[f.id]= f.type==="number"? parseNum(f.def) : f.def; }
        else if(f.type==="number"){ vals[f.id]= parseNum(el.value); }
        else { vals[f.id]= el.value; }
      });
      return vals;
    }
    function escAttr(s){ return String(s??"").replace(/&/g,"&amp;").replace(/"/g,"&quot;").replace(/</g,"&lt;"); }
    function errText(f){
      if(f.type==="number"){ const m=f.min??0; return m>0 ? "Kolom ini wajib diisi dengan angka yang valid (minimal "+String(m).replace(".",",")+")." : "Kolom ini wajib diisi dengan angka yang valid (0 atau lebih)."; }
      return "Kolom ini wajib diisi.";
    }
    function checkField(f, val){
      if(f.type==="number"){ return typeof val==="number" && isFinite(val) && !isNaN(val) && val >= (f.min??0); }
      if(f.type==="text"){ return (f.id==="produk"||f.id==="aktif") ? true : String(val??"").trim().length>0; }
      return true;
    }
    function setFieldError(wrap, invalid){
      if(!wrap) return;
      wrap.classList.toggle("invalid", !!invalid);
      const err=$(".err", wrap); if(err) err.hidden=!invalid;
      const ctl=$("input, select", wrap); if(ctl) ctl.setAttribute("aria-invalid", invalid?"true":"false");
    }
    function validateFieldLive(tool, id){
      const f=tool.fields.find(x=>x.id===id); if(!f) return;
      const box=$("#calc-fields"); if(!box) return;
      const wrap=$(`.field[data-field="${id}"]`, box); if(!wrap) return;
      const form=$("#calc-form");
      const submitted=form && form.dataset.submitted==="1";
      const ctl=$("[name='"+id+"']", wrap);
      const touched=ctl && ctl.dataset.touched==="1";
      if(!submitted && !touched && !wrap.classList.contains("invalid")) return;
      const vals=collectValsSafe(tool);
      if(!fieldVisible(f, vals)){ setFieldError(wrap,false); return; }
      setFieldError(wrap, !checkField(f, vals[id]));
    }
    function renderFields(tool){
      const box=$("#calc-fields");
      const vals=collectValsSafe(tool);
      box.innerHTML = tool.fields.filter(f=>fieldVisible(f, vals)).map(f=>{
        const cur=vals[f.id];
        let input="";
        if(f.type==="number"||f.type==="text"){
          const v=(cur===undefined||cur===null||(typeof cur==="number"&&isNaN(cur))) ? (f.def??"") : cur;
          input=`<input type="text" inputmode="${f.type==="number"?"decimal":"text"}" name="${f.id}" value="${escAttr(v)}" autocomplete="off" spellcheck="false" ${f.placeholder?`placeholder="${escAttr(f.placeholder)}"`:""} aria-describedby="${f.hint?("hint-"+f.id+" "):""}err-${f.id}" />`;
        }
        else if(f.type==="select"){ const sel=(cur===undefined||cur===null)? f.def : cur; input=`<select name="${f.id}" aria-describedby="${f.hint?("hint-"+f.id+" "):""}err-${f.id}">${f.options.map(o=>`<option value="${escAttr(o[0])}" ${String(o[0])===String(sel)?"selected":""}>${o[1]}</option>`).join("")}</select>`; }
        else if(f.type==="selectObj"){ const sel=(cur===undefined||cur===null)? f.def : cur; input=`<select name="${f.id}" aria-describedby="${f.hint?("hint-"+f.id+" "):""}err-${f.id}">${RANTES().map(o=>`<option value="${escAttr(o.id)}" ${String(o.id)===String(sel)?"selected":""}>${o.label}</option>`).join("")}</select>`; }
        else if(f.type==="seg"){ const sel=(cur===undefined||cur===null)? f.def : cur; input=`<div class="seg" role="group" aria-label="${escAttr(f.label)}">${f.options.map(o=>`<button type="button" data-f="${f.id}" data-v="${escAttr(o[0])}" class="${String(o[0])===String(sel)?"on":""}">${o[1]}</button>`).join("")}</div>`; }
        return `<div class="field" data-field="${f.id}"><label for="f-${f.id}">${f.label}</label>${input.replace('name=', 'id="f-'+f.id+'" name=')}${f.hint?`<div class="hint" id="hint-${f.id}">${f.hint}</div>`:""}<div class="err" id="err-${f.id}" role="alert" hidden>${errText(f)}</div></div>`;
      }).join("");
      // seg buttons
      $$(".seg button", box).forEach(b=>b.addEventListener("click",()=>{ $$(`.seg button[data-f="${b.dataset.f}"]`,box).forEach(x=>x.classList.remove("on")); b.classList.add("on"); renderFields(tool); }));
      // live validation: error hanya tampil setelah submit / field disentuh, dan hilang begitu valid
      $$("select, input", box).forEach(el=>{
        el.addEventListener("input",()=>validateFieldLive(tool, el.name));
        el.addEventListener("blur",()=>{ el.dataset.touched="1"; validateFieldLive(tool, el.name); });
      });
      // change listeners: pupuk auto-dose, showIf refresh
      $$("select, input", box).forEach(el=>el.addEventListener("change",()=>{
        if(tool.id==="pupuk" && (el.name==="tanaman"||el.name==="pupuk")){
          const v=collectVals(tool); const rec=(PUPUK_REKOMENDASI[v.tanaman]||{})[v.pupuk];
          const dEl=$("[name='dosis']",box); if(rec && dEl){ dEl.value=rec; toast("Dosis rekomendasi "+TANAMAN_LABEL[v.tanaman]+" — "+PUPUK_LABEL[v.pupuk]+": "+rec+" kg/ha"); }
        }
        renderFieldsSoft(tool);
        validateFieldLive(tool, el.name);
      }));
    }
    function RANTES(){ return RANTE_STANDAR; }
    function collectValsSafe(tool){
      const vals={};
      tool.fields.forEach(f=>{ vals[f.id]= f.type==="number"? parseNum(f.def) : f.def; });
      const box=$("#calc-fields");
      if(box){ tool.fields.forEach(f=>{
        const el=$("[name='"+f.id+"']",box);
        if(f.type==="seg"){ const on=$(".seg button.on[data-f='"+f.id+"']",box); if(on) vals[f.id]=on.dataset.v; }
        else if(el){ vals[f.id]= f.type==="number"? parseNum(el.value) : el.value; }
      }); }
      return vals;
    }
    function renderFieldsSoft(tool){
      const vals=collectValsSafe(tool);
      tool.fields.forEach(f=>{
        const wrap=$(`.field[data-field="${f.id}"]`, $("#calc-fields"));
        const should=fieldVisible(f, vals);
        if(should && !wrap){ renderFields(tool); }
        if(!should && wrap){ renderFields(tool); }
      });
    }
    function openCalc(id){
      const tool=toolById(id); if(!tool){ location.hash="#/tools"; return; }
      currentTool=tool; currentResult=null;
      $("#calc-crumb-name").textContent=tool.name;
      $("#calc-title").textContent=tool.name;
      $("#calc-desc").textContent=tool.desc;
      document.title=tool.name+" Online Gratis | Petani Bijak Indonesia";
      const metaDesc=document.querySelector('meta[name="description"]');
      if(metaDesc) metaDesc.setAttribute("content", tool.name+" online gratis di Petani Bijak Indonesia (petanibijakindonesia.click). "+tool.desc);
      const ldCalc=$("#ld-dynamic");
      if(ldCalc) ldCalc.textContent=JSON.stringify({"@context":"https://schema.org","@type":"WebApplication","name":tool.name+" — Petani Bijak Indonesia","url":SITE_URL+"/#/tools/"+tool.id,"applicationCategory":"UtilitiesApplication","operatingSystem":"Web","inLanguage":"id-ID","description":tool.desc,"isPartOf":{"@id":"#site"},"publisher":{"@id":"#org"},"offers":{"@type":"Offer","price":"0","priceCurrency":"IDR"}});
      const artBox=$("#calc-art"); artBox.setAttribute("role","img"); artBox.setAttribute("aria-label","Foto "+tool.name+" — Petani Bijak Indonesia");
      artBox.innerHTML=ILLUS[tool.illus]();
      $("#calc-extra-note").innerHTML = tool.id==="pestisida"
        ? `<div class="note-box note-warn"><b>Utamakan keselamatan</b>Dosis pada kalkulator ini selalu berasal dari label resmi produk yang Anda masukkan. Baca label sebelum membuka kemasan dan gunakan APD lengkap saat aplikasi.</div>`
        : tool.id==="pupuk"
        ? `<div class="note-box note-info"><b>Rekomendasi spesifik lokasi</b>Dosis terisi otomatis dari kisaran rekomendasi per tanaman. Sesuaikan dengan hasil uji tanah (PUTS/PUTK) atau anjuran penyuluh setempat.</div>`
        : "";
      const fb=$("#calc-fields"); if(fb) fb.innerHTML="";
      const cf=$("#calc-form"); if(cf) delete cf.dataset.submitted;
      renderFields(tool);
      $("#calc-result").innerHTML=`<div class="result-empty"><div class="big" aria-hidden="true">🌾</div>Belum ada hasil.<br/>Isi formulir di samping, lalu tekan <b>Hitung Sekarang</b>.</div>`;
      renderHistory();
      showView("calc"); setNav("tools");
    }
    function runCalc(e){
      e.preventDefault(); if(!currentTool) return;
      const tool=currentTool, vals=collectValsSafe(tool);
      const form=$("#calc-form"); if(form) form.dataset.submitted="1";
      let ok=true, firstBad=null;
      tool.fields.forEach(f=>{
        if(!fieldVisible(f, vals)) return;
        const wrap=$(`.field[data-field="${f.id}"]`, $("#calc-fields"));
        const valid=checkField(f, vals[f.id]);
        setFieldError(wrap, !valid);
        if(!valid){ ok=false; if(!firstBad) firstBad=wrap; }
      });
      if(!ok){ toast("Periksa kembali kolom yang ditandai merah."); if(firstBad){ const ctl=$("input, select", firstBad); if(ctl) ctl.focus(); } return; }
      const res=tool.compute(vals);
      currentResult={tool, vals, res, time:new Date()};
      history.unshift(currentResult); if(history.length>8) history.pop();
      $("#calc-result").innerHTML=`
        <div class="res-highlight"><small>${res.highlight.label}</small><div class="val">${res.highlight.val}</div><div class="val2">${res.highlight.sub||""}</div></div>
        <div class="res-rows">${res.rows.map(r=>`<div class="res-row"><span>${r[0]}</span><b>${r[1]}</b></div>`).join("")}</div>
        ${res.chart||""}
        ${res.note?`<div class="note-box note-${res.note.type}"><b>${res.note.title}</b>${res.note.text}</div>`:""}
        <div class="res-actions">
          <button type="button" class="btn btn-primary btn-sm" id="res-copy">Salin Hasil</button>
          <button type="button" class="btn btn-ghost btn-sm" id="res-pdf">Unduh Laporan PDF</button>
          <button type="button" class="btn btn-ghost btn-sm" id="res-share">Bagikan</button>
        </div>`;
      $("#res-copy").addEventListener("click", copyResult);
      $("#res-pdf").addEventListener("click", downloadPDF);
      $("#res-share").addEventListener("click", shareResult);
      renderHistory();
      $("#calc-result-panel").scrollIntoView({behavior:"smooth", block:"nearest"});
    }
    function inputRecap(){
      if(!currentResult) return [];
      const {tool,vals}=currentResult;
      return tool.fields.filter(f=>fieldVisible(f,vals)).map(f=>{
        let val=vals[f.id];
        let disp="";
        if(f.type==="select" && f.options){ const o=f.options.find(o=>String(o[0])===String(val)); disp=o? o[1] : String(val??"—"); }
        else if(f.type==="selectObj"){ const o=RANTES().find(o=>o.id===val); disp=o? o.label : String(val??"—"); }
        else if(f.type==="seg" && f.options){ const o=f.options.find(o=>String(o[0])===String(val)); disp=o? o[1] : String(val??"—"); }
        else if(f.type==="number"){ disp=isNaN(val)? "—" : fmtNum(val,4); }
        else { disp=String(val??"").trim()||"—"; }
        return [f.label.replace(/\s*\(.*?\)\s*/g," ").trim(), disp];
      });
    }
    function resultText(){
      if(!currentResult) return "";
      const {tool,res}=currentResult;
      return ["PETANI BIJAK INDONESIA — Laporan Hasil Perhitungan", tool.name, "Tanggal: "+currentResult.time.toLocaleString("id-ID"), "———————————————",
        "DATA YANG DIMASUKKAN", ...inputRecap().map(r=>r[0]+": "+r[1]), "———————————————",
        res.highlight.label+": "+res.highlight.val, res.highlight.sub||"",
        ...res.rows.map(r=>r[0]+": "+r[1]), "———————————————", "Dihitung di Petani Bijak Indonesia (petanibijakindonesia.click) — Petani Cerdas, Hasil Berkualitas.", "Kontak: renaldosinaga98@gmail.com"].filter(Boolean).join("\n");
    }
    async function copyResult(){
      const txt=resultText(); if(!txt) return;
      try{ await navigator.clipboard.writeText(txt); toast("Hasil perhitungan tersalin."); }
      catch(e){ const ta=document.createElement("textarea"); ta.value=txt; document.body.appendChild(ta); ta.select(); document.execCommand("copy"); ta.remove(); toast("Hasil perhitungan tersalin."); }
    }
    /* ================= PDF: pemuat dinamis jsPDF ================= */
    var JSPDF_URL = "https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js";
    function loadJsPDFOnce(){
      return new Promise(function(resolve){
        if(window.jspdf && window.jspdf.jsPDF){ resolve(true); return; }
        var s=document.createElement("script");
        s.src=JSPDF_URL; s.async=true;
        var done=false;
        var timer=setTimeout(function(){ try{s.remove();}catch(e){} finish(false); }, 9000);
        function finish(ok){ if(done) return; done=true; clearTimeout(timer); resolve(!!ok && !!(window.jspdf && window.jspdf.jsPDF)); }
        s.onload=function(){ finish(true); };
        s.onerror=function(){ try{s.remove();}catch(e){} finish(false); };
        document.head.appendChild(s);
      });
    }
    async function ensureJsPDF(){
      if(window.jspdf && window.jspdf.jsPDF) return true;
      if(await loadJsPDFOnce()) return true;
      return loadJsPDFOnce(); /* satu kali retry */
    }
    async function downloadPDF(){
      if(!currentResult) return;
      var snapshot=currentResult;
      var btn=document.getElementById("res-pdf");
      if(btn){ btn.disabled=true; btn.textContent="Menyiapkan PDF…"; }
      toast("Menyiapkan laporan PDF berdesain…");
      try{
        var ok=await ensureJsPDF();
        if(!ok) throw new Error("Perpustakaan PDF tidak dapat dimuat.");
        buildReportPDF(snapshot);
        toast("Laporan PDF berhasil diunduh.");
      }catch(err){
        toast("Maaf, laporan PDF gagal dibuat. Periksa koneksi internet Anda, lalu tekan tombol Unduh Laporan PDF sekali lagi.");
      }finally{
        var b=document.getElementById("res-pdf");
        if(b){ b.disabled=false; b.textContent="Unduh Laporan PDF"; }
      }
    }
    function buildReportPDF(snapshot){
      var tool=snapshot.tool, res=snapshot.res, time=snapshot.time, vals=snapshot.vals;
      var doc=new window.jspdf.jsPDF({unit:"mm", format:"a4"});
      var W=210, H=297, M=16, CW=W-2*M;
      var FOREST=[23,75,53], AGRI=[50,134,83], LIME=[164,201,107], LIMELT=[220,236,192],
          CREAM=[248,247,239], LIGHT=[238,243,228], INK=[32,44,36], SOFT=[74,90,78],
          LINEC=[216,222,204], WHITE=[255,255,255], GOLD=[217,164,65],
          WARNBG=[251,243,220], WARNINK=[122,91,18], TRACK=[233,238,224], RUST=[178,64,42];
      var reportNo="PB-"+time.getFullYear()+String(time.getMonth()+1).padStart(2,"0")+String(time.getDate()).padStart(2,"0")+"-"+String(time.getTime()).slice(-5);
      var dateLong=time.toLocaleString("id-ID",{day:"numeric",month:"long",year:"numeric",hour:"2-digit",minute:"2-digit"})+" WIB";
      var y=0, page=1;
      function fill(c){ doc.setFillColor(c[0],c[1],c[2]); }
      function txt(c){ doc.setTextColor(c[0],c[1],c[2]); }
      function drawC(c){ doc.setDrawColor(c[0],c[1],c[2]); }
      function safe(fn){ try{ fn(); }catch(e){} }
      /* Font standar jsPDF (helvetica) memakai encoding WinAnsi yang tidak punya
         glyph untuk ≥, ≤, ±, ×, →, •, subskrip (₂, ₅), dsb. — karakter itu rusak
         atau keluar jalur saat digambar. pdfSafe memetakan semuanya ke padanan
         ASCII yang aman; diterapkan ke SEMUA teks yang masuk ke PDF. */
      function pdfSafe(s){
        return String(s)
          .replace(/≥/g,">=").replace(/≤/g,"<=")
          .replace(/±/g,"+/-").replace(/×/g,"x")
          .replace(/→/g,"->").replace(/←/g,"<-")
          .replace(/•/g,"-").replace(/≈/g,"~").replace(/−/g,"-")
          .replace(/₂/g,"2").replace(/₅/g,"5")
          .replace(/─/g,"-").replace(/│/g,"|").replace(/├/g,"-").replace(/└/g,"-")
          .replace(/🌾|🌱|✉/g,"");
      }
      function footer(){
        doc.setLineWidth(0.3); drawC(LINEC); doc.line(M,H-15,W-M,H-15);
        doc.setFont("helvetica","normal"); doc.setFontSize(7.4); txt(SOFT);
        doc.text(pdfSafe("Petani Bijak Indonesia  ·  petanibijakindonesia.click  ·  renaldosinaga98@gmail.com"), M, H-10);
        doc.text("Halaman "+page, W-M, H-10, {align:"right"});
        txt(INK);
      }
      function contHeader(){
        fill(FOREST); doc.rect(0,0,W,12,"F");
        fill(LIME); doc.rect(0,12,W,0.9,"F");
        doc.setFont("helvetica","bold"); doc.setFontSize(8.4); txt(WHITE);
        doc.text("PETANI BIJAK INDONESIA", M, 7.8);
        doc.setFont("helvetica","normal"); txt(LIMELT);
        doc.text(pdfSafe("No. "+reportNo), W-M, 7.8, {align:"right"});
        txt(INK); y=19;
      }
      function ensure(h){ if(y+h>H-19){ footer(); doc.addPage(); page++; contHeader(); } }
      function sectionTitle(t){
        ensure(13);
        doc.setFont("helvetica","bold"); doc.setFontSize(11); txt(FOREST);
        doc.text(pdfSafe(t), M, y+4.2);
        safe(function(){ fill(LIME); doc.rect(M, y+6.2, 16, 1.2, "F"); });
        y+=10.6;
      }
      function table(rows, c1w, header){
        if(header){
          ensure(9.5);
          fill(AGRI); doc.rect(M,y,CW,8.5,"F");
          doc.setFont("helvetica","bold"); doc.setFontSize(8.6); txt(WHITE);
          doc.text(pdfSafe(header[0]), M+3, y+5.6);
          doc.text(pdfSafe(header[1]), M+c1w+3, y+5.6);
          y+=8.5; txt(INK);
        }
        rows.forEach(function(r,i){
          doc.setFontSize(9.4);
          doc.setFont("helvetica","normal");
          var l1=doc.splitTextToSize(pdfSafe(r[0]), c1w-6);
          doc.setFont("helvetica","bold");
          var l2=doc.splitTextToSize(pdfSafe(r[1]), CW-c1w-6);
          var h=Math.max(l1.length,l2.length)*4.5+3.6;
          ensure(h);
          if(i%2===0){ fill(CREAM); doc.rect(M,y,CW,h,"F"); }
          doc.setLineWidth(0.2); drawC(LINEC); doc.line(M,y,M+CW,y);
          doc.setFont("helvetica","normal"); txt(SOFT); doc.text(l1, M+3, y+5.5);
          doc.setFont("helvetica","bold"); txt(INK); doc.text(l2, M+c1w+3, y+5.5);
          y+=h;
        });
        doc.setLineWidth(0.2); drawC(LINEC); doc.line(M,y,M+CW,y);
        y+=3.8;
      }
      /* ===== Kop utama ===== */
      fill(FOREST); doc.rect(0,0,W,36,"F");
      fill(AGRI); doc.rect(0,36,W,1.6,"F");
      fill(LIME); doc.rect(0,37.6,W,0.8,"F");
      safe(function(){
        fill(LIME); doc.rect(M,7.5,14,14,"F");
        doc.setFont("helvetica","bold"); doc.setFontSize(10.5); txt(FOREST);
        doc.text("PB", M+7, 16.9, {align:"center"});
      });
      doc.setFont("helvetica","bold"); doc.setFontSize(15.5); txt(WHITE);
      doc.text("PETANI BIJAK INDONESIA", M+18, 13.8);
      doc.setFont("helvetica","normal"); doc.setFontSize(8.6); txt(LIME);
      doc.text("Petani Cerdas, Hasil Berkualitas", M+18, 19.2);
      doc.setFontSize(7.8); txt(LIMELT);
      doc.text("Platform Kalkulator Pertanian & Panduan Budidaya Indonesia", M+18, 24);
      doc.text("petanibijakindonesia.click  ·  Renaldo Sinaga — Team Vexora", M+18, 28.6);
      doc.setFont("helvetica","bold"); doc.setFontSize(10.5); txt(WHITE);
      doc.text("LAPORAN HASIL", W-M, 13, {align:"right"});
      doc.text("PERHITUNGAN", W-M, 18.2, {align:"right"});
      doc.setFont("helvetica","normal"); doc.setFontSize(8); txt(LIME);
      doc.text(pdfSafe("No. "+reportNo), W-M, 23.8, {align:"right"});
      doc.setFontSize(7.6); txt(LIMELT);
      doc.text(pdfSafe(dateLong), W-M, 28.4, {align:"right"});
      txt(INK);
      /* ===== Strip meta ===== */
      y=43;
      var dateShort=time.toLocaleDateString("id-ID",{day:"numeric",month:"short",year:"numeric"})+" · "+String(time.getHours()).padStart(2,"0")+"."+String(time.getMinutes()).padStart(2,"0")+" WIB";
      var metaCols=[
        ["KALKULATOR", tool.name, 62],
        ["TANGGAL LAPORAN", dateShort, 56],
        ["KATEGORI", tool.cat, 46]
      ];
      doc.setFont("helvetica","normal"); doc.setFontSize(8.8);
      var metaLines=metaCols.map(function(c){ return doc.splitTextToSize(pdfSafe(c[1]), c[2]); });
      var metaH=9.5+Math.max.apply(null, metaLines.map(function(l){return l.length;}))*4.3+2;
      fill(LIGHT); doc.rect(M,y,CW,metaH,"F");
      var mx=M+4;
      metaCols.forEach(function(c,i){
        doc.setFont("helvetica","bold"); doc.setFontSize(7.4); txt(SOFT);
        doc.text(pdfSafe(c[0]), mx, y+5.6);
        doc.setFont("helvetica","normal"); doc.setFontSize(8.8); txt(INK);
        doc.text(metaLines[i], mx, y+10.6);
        mx+=c[2]+8;
      });
      y+=metaH+5;
      /* ===== Hasil utama ===== */
      sectionTitle("Hasil Utama");
      var valSize=20;
      doc.setFont("helvetica","bold");
      var valLines=null;
      [20,17,14.5,12.5].forEach(function(s){
        if(valLines) return;
        doc.setFontSize(s);
        var l=doc.splitTextToSize(pdfSafe(res.highlight.val), CW-15);
        if(l.length<=2){ valSize=s; valLines=l; }
      });
      if(!valLines){ doc.setFontSize(12.5); valLines=doc.splitTextToSize(pdfSafe(res.highlight.val), CW-15); }
      doc.setFont("helvetica","normal"); doc.setFontSize(9);
      var subLines=res.highlight.sub ? doc.splitTextToSize(pdfSafe(res.highlight.sub), CW-15) : [];
      var hlH=9.5+valLines.length*(valSize*0.45)+ (subLines.length? subLines.length*4.4+2 : 0) +2.5;
      ensure(hlH+2);
      fill(FOREST); doc.rect(M,y,CW,hlH,"F");
      safe(function(){ fill(LIME); doc.rect(M,y,2.4,hlH,"F"); });
      doc.setFont("helvetica","bold"); doc.setFontSize(8.2); txt(LIME);
      doc.text(pdfSafe(String(res.highlight.label).toUpperCase()), M+7, y+6.5);
      doc.setFontSize(valSize); txt(WHITE);
      doc.text(valLines, M+7, y+6.5+valSize*0.45+1.2);
      if(subLines.length){
        doc.setFont("helvetica","normal"); doc.setFontSize(9); txt(LIMELT);
        doc.text(subLines, M+7, y+6.5+valLines.length*(valSize*0.45)+6.4);
      }
      txt(INK); y+=hlH+4;
      /* ===== Data yang dimasukkan ===== */
      sectionTitle("Data yang Dimasukkan");
      var recap=(function(){
        var keep=currentResult; currentResult=snapshot;
        var r=inputRecap(); currentResult=keep; return r;
      })();
      table(recap, 88, null);
      /* ===== Rincian hasil ===== */
      sectionTitle("Rincian Hasil Perhitungan");
      table(res.rows, 104, ["Komponen","Nilai"]);
      /* ===== Grafik khusus Keuntungan Panen ===== */
      if(tool.id==="untung"){
        safe(function(){
          var totalKg=vals.luas*vals.hasil, pend=totalKg*vals.harga, unt=pend-vals.biaya;
          var max=Math.max(pend, vals.biaya, Math.max(unt,0))||1;
          sectionTitle("Grafik Pendapatan vs Biaya");
          [["Pendapatan kotor", pend, AGRI],["Total biaya produksi", vals.biaya, RUST],["Keuntungan bersih", Math.max(unt,0), AGRI]].forEach(function(b,bi){
            ensure(13);
            doc.setFont("helvetica","normal"); doc.setFontSize(8.8); txt(INK);
            doc.text(pdfSafe(b[0]), M, y+3.8);
            doc.setFont("helvetica","bold");
            doc.text(fmtIDR(b[1]), W-M, y+3.8, {align:"right"});
            fill(TRACK); doc.rect(M,y+5.6,CW,3.8,"F");
            if(b[1]>0){ fill(bi===2?LIME:b[2]); doc.rect(M,y+5.6,Math.max(4,CW*b[1]/max),3.8,"F"); }
            y+=12.5;
          });
          if(unt<0){
            doc.setFont("helvetica","normal"); doc.setFontSize(8.6); txt(RUST);
            doc.text(pdfSafe("Keuntungan bersih negatif ("+fmtIDR(unt)+") — lihat catatan di bawah."), M, y+2);
            y+=6;
          }
          y+=2; txt(INK);
        });
      }
      /* ===== Catatan / peringatan ===== */
      if(res.note){
        var warn=res.note.type==="warn";
        doc.setFont("helvetica","normal"); doc.setFontSize(8.9);
        var nLines=doc.splitTextToSize(pdfSafe(res.note.text), CW-11);
        var nH=10.5+nLines.length*4.3+1.5;
        ensure(nH+2);
        fill(warn?WARNBG:LIGHT); doc.rect(M,y,CW,nH,"F");
        safe(function(){ fill(warn?GOLD:LIME); doc.rect(M,y,2.4,nH,"F"); });
        doc.setFont("helvetica","bold"); doc.setFontSize(9.4); txt(warn?WARNINK:FOREST);
        doc.text(pdfSafe(res.note.title), M+5.5, y+6.2);
        /* Isi catatan: helvetica normal 8.9pt warna INK, digambar baris per baris
           dengan jarak tetap 4.3mm — persis angka yang dipakai menghitung tinggi
           kotak — tanpa charSpace/tracking dan tanpa justify, agar rapat & rapi. */
        doc.setFont("helvetica","normal"); doc.setFontSize(8.9); txt(INK);
        nLines.forEach(function(ln,li){ doc.text(ln, M+5.5, y+11.6+li*4.3); });
        y+=nH+4;
      }
      /* ===== Disclaimer ===== */
      var discTxt="Hasil ini adalah estimasi perencanaan berdasarkan data yang Anda masukkan dan acuan rekomendasi agronomis umum (Kementerian Pertanian/Balitbangtan). Hasil nyata dipengaruhi cuaca, varietas, kesuburan tanah, dan harga pasar. Untuk dosis pestisida, selalu ikuti label resmi produk. Bagikan laporan ini kepada kelompok tani atau penyuluh Anda bila diperlukan.";
      var discPre=doc.splitTextToSize(pdfSafe(discTxt), CW);
      ensure(9+discPre.length*3.6);
      doc.setFont("helvetica","bold"); doc.setFontSize(8.4); txt(FOREST);
      doc.text("Catatan Penting", M, y+3.6);
      doc.setFont("helvetica","normal"); doc.setFontSize(8); txt(SOFT);
      doc.text(discPre, M, y+7.6);
      y+=8.6+discPre.length*3.6;
      footer();
      doc.save("laporan-"+tool.id+"-petani-bijak-indonesia.pdf");
    }
    async function shareResult(){
      const txt=resultText(); if(!txt) return;
      if(navigator.share){ try{ await navigator.share({title:"Hasil Perhitungan — Petani Bijak Indonesia", text:txt}); }catch(e){} }
      else { copyResult(); }
    }
    function renderHistory(){
      const box=$("#calc-history"), list=$("#calc-history-list");
      const items=history.filter(h=>currentTool && h.tool.id===currentTool.id);
      if(!items.length){ box.hidden=true; return; }
      box.hidden=false;
      list.innerHTML=items.map(h=>`<div class="hist-item"><div><b>${h.res.highlight.val}</b><span>${h.res.highlight.label}</span></div><time>${h.time.toLocaleTimeString("id-ID",{hour:"2-digit",minute:"2-digit"})}</time></div>`).join("");
    }

    /* ---------------- Artikel ---------------- */
    function openArticle(slug){
      const a=ARTICLES.find(x=>x.slug===slug); if(!a || !isPublished(a)){ location.hash="#/artikel"; return; }
      const toc=a.body.map((s,i)=>`<li><a href="#/artikel/${a.slug}" data-toc="${i}">${s[0]}</a></li>`).join("");
      const bodyHtml=a.body.map((s,i)=>`<h2 id="sec-${i}">${s[0]}</h2>${s[1].map(p=> p.startsWith("•")? "" : `<p>${p}</p>`).join("")}`).join("");
      const related=publishedArticles().filter(x=>x.slug!==a.slug && x.cat===a.cat).concat(publishedArticles().filter(x=>x.slug!==a.slug && x.cat!==a.cat)).slice(0,3);
      $("#article-content").innerHTML=`
        <div class="crumb"><a href="#/">Beranda</a> <span>›</span> <a href="#/artikel">Artikel</a> <span>›</span> <span>${a.cat}</span></div>
        <span class="pill">${a.cat}</span>
        <h1>${a.title}</h1>
        <p style="color:var(--ink-soft)">Oleh <b>${a.author}</b> · ${fmtDate(a.date)} · ${a.read}</p>
        <div class="article-hero">${ART_THUMB[a.thumb]()}</div>
        <div class="toc"><b>Daftar Isi</b><ol>${toc}</ol></div>
        <div class="article-body">${bodyHtml}</div>
        <div class="refs"><b>Referensi</b><ul>${a.refs.map(r=>`<li>${r}</li>`).join("")}</ul></div>
        <div class="author-box"><div class="avatar">${a.author.split(" ").map(w=>w[0]).slice(0,2).join("")}</div><div style="flex:1;min-width:230px"><b>Ditulis oleh ${a.author}</b><p>${a.author==="Renaldo Sinaga" ? "Pendiri & pengelola Petani Bijak Indonesia — bertanggung jawab atas arah produk, konten panduan pertanian, dan akurasi kalkulator di platform ini." : "Bagian dari Team Vexora, tim teknologi & desain di balik Petani Bijak Indonesia."} Ada koreksi atau saran untuk artikel ini? Kirim ke <a href="mailto:renaldosinaga98@gmail.com">renaldosinaga98@gmail.com</a>.</p></div></div>
        <h2 style="font-size:1.35rem;font-weight:800;margin:34px 0 16px">Artikel Terkait</h2>
        <div class="art-grid" style="grid-template-columns:1fr">${related.map(artCard).join("")}</div>`;
      $$("#article-content [data-toc]").forEach(l=>l.addEventListener("click",e=>{ e.preventDefault(); const el=document.getElementById("sec-"+l.dataset.toc); if(el) el.scrollIntoView({behavior:"smooth"}); }));
      document.title=a.title+" | Petani Bijak Indonesia";
      const ld=$("#ld-dynamic");
      if(ld) ld.textContent=JSON.stringify({"@context":"https://schema.org","@type":"Article","headline":a.title,"description":a.excerpt,"url":SITE_URL+"/#/artikel/"+a.slug,"mainEntityOfPage":SITE_URL+"/#/artikel/"+a.slug,"inLanguage":"id-ID","datePublished":a.date,"dateModified":a.date,"author":{"@type":"Person","name":a.author},"publisher":{"@type":"Organization","name":"Petani Bijak Indonesia","url":SITE_URL+"/"},"articleSection":a.cat,"breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Beranda","item":SITE_URL+"/"},{"@type":"ListItem","position":2,"name":"Panduan & Artikel","item":SITE_URL+"/#/artikel"},{"@type":"ListItem","position":3,"name":a.title,"item":SITE_URL+"/#/artikel/"+a.slug}]}});
      showView("article"); setNav("artikel"); window.scrollTo({top:0});
    }
    let artCat="Semua";
    function renderArticles(){
      $("#art-filter").innerHTML=ART_CATS.map(c=>`<button type="button" data-c="${c}" class="${c===artCat?"on":""}">${c}</button>`).join("");
      $$("#art-filter button").forEach(b=>b.addEventListener("click",()=>{ artCat=b.dataset.c; renderArticles(); }));
      const list=publishedArticles().filter(a=>artCat==="Semua"||a.cat===artCat);
      $("#articles-grid").innerHTML= list.length? list.map(artCard).join("") : `<p style="color:var(--ink-soft)">Belum ada artikel pada kategori ini. Kategori lain dapat dibaca melalui tombol di atas — artikel baru ditambahkan berkala melalui CMS.</p>`;
    }

    /* ---------------- Tools list ---------------- */
    let toolQuery="", toolCat="Semua";
    function renderTools(){
      const cats=["Semua",...new Set(TOOLS.map(t=>t.cat))];
      $("#tools-filter").innerHTML=cats.map(c=>`<button type="button" data-c="${c}" class="${c===toolCat?"on":""}">${c}</button>`).join("");
      $$("#tools-filter button").forEach(b=>b.addEventListener("click",()=>{ toolCat=b.dataset.c; renderTools(); }));
      const q=toolQuery.trim().toLowerCase();
      const list=TOOLS.filter(t=>(toolCat==="Semua"||t.cat===toolCat) && (!q || (t.name+" "+t.desc+" "+t.cat).toLowerCase().includes(q)));
      $("#tools-grid").innerHTML=list.map(toolCard).join("");
      $("#tools-empty").hidden=list.length>0;
    }
    function toolSearchResults(q){
      q=q.trim().toLowerCase(); if(!q) return [];
      return TOOLS.filter(t=>(t.name+" "+t.desc+" "+t.cat).toLowerCase().includes(q));
    }

    /* ---------------- Router & tampilan ---------------- */
    const VIEWS={home:"view-home", tools:"view-tools", calc:"view-calc", articles:"view-articles", article:"view-article", page:"view-page"};
    function showView(key){ Object.values(VIEWS).forEach(id=>$("#"+id).classList.remove("active")); $("#"+VIEWS[key]).classList.add("active"); }
    function setNav(key){ $$("nav.main a").forEach(a=>a.classList.toggle("active", a.dataset.nav===key)); }
    function route(){
      const hash=location.hash.replace(/^#\/?/,"");
      const parts=hash.split("/");
      $("#mobile-menu").classList.remove("open");
      if(parts[0]===""||parts[0]==="home"){ showView("home"); setNav("home"); window.scrollTo({top:0}); }
      else if(parts[0]==="tools" && parts[1]){ openCalc(parts[1]); window.scrollTo({top:0}); }
      else if(parts[0]==="tools"){ showView("tools"); setNav("tools"); renderTools(); window.scrollTo({top:0}); }
      else if(parts[0]==="artikel" && parts[1]){ openArticle(parts[1]); }
      else if(parts[0]==="artikel"){ showView("articles"); setNav("artikel"); renderArticles(); window.scrollTo({top:0}); }
      else if(PAGES[parts[0]]){ const p=PAGES[parts[0]]; $("#page-content").innerHTML=p.html; showView("page"); setNav(p.nav); document.title=p.title+" — Petani Bijak Indonesia"; window.scrollTo({top:0}); }
      else { showView("home"); setNav("home"); }
      if(!PAGES[parts[0]] && !(parts[0]==="artikel" && parts[1]) && !(parts[0]==="tools" && parts[1])){
        document.title="Petani Bijak Indonesia — Kalkulator Pertanian Online Gratis: Benih Padi, Pupuk, Biaya Tanam & Keuntungan Panen";
        const md=document.querySelector('meta[name="description"]');
        if(md) md.setAttribute("content","Petani Bijak Indonesia (petanibijakindonesia.click) — kalkulator pertanian online gratis: hitung kebutuhan benih padi, dosis pupuk per tanaman untuk cabai, terong, pare, semangka, melon, tomat, mentimun, bawang merah & kentang, luas lahan, konversi hektare ke rante, biaya tanam, keuntungan panen & BEP usaha tani, serta dosis pestisida sesuai label. Dilengkapi panduan budidaya semua komoditas. Petani Cerdas, Hasil Berkualitas.");
        const ldHome=$("#ld-dynamic");
        if(ldHome) ldHome.textContent=JSON.stringify({"@context":"https://schema.org","@type":"WebPage","name":"Petani Bijak Indonesia — Kalkulator Pertanian Online Gratis","url":SITE_URL+"/","inLanguage":"id-ID","isPartOf":{"@id":"#site"},"publisher":{"@id":"#org"}});
      }
    }

    /* ---------------- Inisialisasi ---------------- */
    function initTheme(){
      const prefersDark=window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = prefersDark? "dark":"light";
      $("#btn-theme").addEventListener("click",()=>{
        const cur=document.documentElement.dataset.theme==="dark"?"light":"dark";
        document.documentElement.dataset.theme=cur;
        toast(cur==="dark"?"Mode gelap aktif.":"Mode terang aktif.");
      });
    }
    document.addEventListener("DOMContentLoaded",()=>{
      initTheme(); renderHome(); renderTools();
      $("#foot-tools").innerHTML=TOOLS.map(t=>`<a href="#/tools/${t.id}">${t.name}</a>`).join("");
      $("#btn-burger").addEventListener("click",()=>{ const m=$("#mobile-menu"); const open=m.classList.toggle("open"); $("#btn-burger").setAttribute("aria-expanded",open); });
      $("#btn-search").addEventListener("click",()=>{ location.hash="#/tools"; setTimeout(()=>$("#tools-search-input").focus(),60); });
      // Hero search
      const hs=$("#hero-search-input"), hr=$("#hero-search-results");
      function updateHeroSearch(){
        const res=toolSearchResults(hs.value);
        if(!hs.value.trim()){ hr.hidden=true; return; }
        hr.hidden=false;
        hr.innerHTML= res.length? res.map(t=>`<a href="#/tools/${t.id}"><span aria-hidden="true">🌱</span>${t.name}</a>`).join("") : `<div class="none">Tidak ditemukan. Coba kata “pupuk”, “benih”, atau “rante”.</div>`;
      }
      hs.addEventListener("input", updateHeroSearch);
      hs.addEventListener("focus", updateHeroSearch);
      document.addEventListener("click",e=>{ if(!$("#hero-search").contains(e.target)) hr.hidden=true; });
      $("#hero-search").addEventListener("submit",e=>{ e.preventDefault(); const res=toolSearchResults(hs.value); if(res.length){ location.hash="#/tools/"+res[0].id; hr.hidden=true; } else { toolQuery=hs.value; location.hash="#/tools"; renderTools(); } });
      // Tools search
      $("#tools-search-input").addEventListener("input",e=>{ toolQuery=e.target.value; renderTools(); });
      $("#tools-search").addEventListener("submit",e=>e.preventDefault());
      // Calculator form
      $("#calc-form").addEventListener("submit", runCalc);
      $("#calc-reset").addEventListener("click",()=>{ if(currentTool){ const cf2=$("#calc-form"); if(cf2) delete cf2.dataset.submitted; renderFields(currentTool); $("#calc-result").innerHTML=`<div class="result-empty"><div class="big" aria-hidden="true">🌾</div>Formulir direset.<br/>Isi kembali data Anda, lalu tekan <b>Hitung Sekarang</b>.</div>`; currentResult=null; } });
      window.addEventListener("hashchange", route);
      route();
    });
    </script>
  </body>
</html>

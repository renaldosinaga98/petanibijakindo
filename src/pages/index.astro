          ${[1,2,3].map(i=>`<path d="M${30+i*59} 26 v128" stroke="#fff" stroke-width="1.6" opacity=".7"/>`).join("")}
          ${[1,2].map(i=>`<path d="M30 ${26+i*43} h236" stroke="#fff" stroke-width="1.6" opacity=".7"/>`).join("")}
          <path d="M30 12 h236" stroke="${PAL.red}" stroke-width="2.6"/><path d="M30 6 v12 M266 6 v12" stroke="${PAL.red}" stroke-width="2.6"/>
          <path d="M282 26 v128" stroke="${PAL.teal}" stroke-width="2.6"/><path d="M276 26 h12 M276 154 h12" stroke="${PAL.teal}" stroke-width="2.6"/>
          <rect x="96" y="66" width="104" height="48" rx="8" fill="#174B35" opacity=".92"/>
          <text x="148" y="88" text-anchor="middle" font-size="15" font-weight="800" fill="#fff">1 RANTE</text>
          <text x="148" y="105" text-anchor="middle" font-size="11" fill="#A4C96B">400 m² · std. Sumut</text>
        </g>
        <g><rect x="66" y="186" width="268" height="14" rx="4" fill="${PAL.gold}"/>${Array.from({length:13},(_,i)=>`<path d="M${78+i*21} 186 v${i%2?6:10}" stroke="${PAL.soilD}" stroke-width="2"/>`).join("")}</g>
      `, PAL.sky); },
      biaya(){ return svgWrap(`
        ${sun(46,38,18)}
        <path d="M0 176 Q200 160 400 176 V215 H0Z" fill="${PAL.hill}"/>
        <g><rect x="118" y="66" width="150" height="102" rx="16" fill="#7A4A2B"/><rect x="118" y="66" width="150" height="102" rx="16" fill="none" stroke="${PAL.soilD}" stroke-width="2.5"/><path d="M118 96 h150 v14 H118Z" fill="${PAL.soilD}" opacity=".45"/><rect x="228" y="98" width="52" height="40" rx="9" fill="${PAL.cream}" stroke="${PAL.soilD}" stroke-width="2.2"/><circle cx="240" cy="118" r="5.5" fill="${PAL.goldD}"/><text x="252" y="123" font-size="13" font-weight="800" fill="#7A4A2B">Rp</text></g>
        <g>${[[86,150,26],[104,168,20],[292,158,23]].map(c=>`<circle cx="${c[0]}" cy="${c[1]}" r="${c[2]}" fill="${PAL.gold}" stroke="${PAL.goldD}" stroke-width="2.6"/><text x="${c[0]}" y="${c[1]+5}" text-anchor="middle" font-size="${c[2]*0.62}" font-weight="800" fill="#8A5E10">Rp</text>`).join("")}</g>
        <g stroke="${PAL.field2}" stroke-width="3" stroke-linecap="round"><path d="M330 178 v-30 M330 156 q-13-13-24-12 M330 156 q13-13 24-12" fill="none"/></g>
        <g transform="rotate(24 66 108)"><rect x="60" y="74" width="11" height="52" rx="5" fill="${PAL.soilD}"/><path d="M54 122 q12-10 24 0 l-4 22 q-8 5-16 0Z" fill="#9AA5A1"/></g>
      `); },
      untung(){ return svgWrap(`
        ${sun(350,36,19)}
        <path d="M0 178 Q200 162 400 178 V215 H0Z" fill="${PAL.soil}"/>
        <g><path d="M52 108 h72 l7 66 H45Z" fill="${PAL.cream}" stroke="${PAL.goldD}" stroke-width="2.4"/><path d="M52 108 h72 l2 16 H50Z" fill="${PAL.gold}"/><ellipse cx="88" cy="104" rx="38" ry="10" fill="#F6E3B4"/><g fill="#EFD894">${[[-22,0],[-8,-4],[8,-4],[22,0],[0,-8]].map(o=>`<circle cx="${88+o[0]}" cy="${100+o[1]}" r="6"/>`).join("")}</g>
        <path d="M238 118 h64 l6 56 h-76Z" fill="${PAL.cream}" stroke="${PAL.goldD}" stroke-width="2.4"/><path d="M238 118 h64 l2 14 h-68Z" fill="${PAL.gold}"/></g>
        <g><rect x="150" y="128" width="24" height="46" fill="${PAL.hill2}"/><rect x="182" y="104" width="24" height="70" fill="${PAL.field2}"/><rect x="214" y="76" width="24" height="98" fill="${PAL.field}" opacity="0"/><path d="M146 118 L196 88 L240 52" stroke="${PAL.red}" stroke-width="3.4" fill="none" stroke-linecap="round"/><path d="M240 52 l-14 1 M240 52 l-2 13" stroke="${PAL.red}" stroke-width="3.4" stroke-linecap="round"/></g>
        <g>${[[330,140,21],[352,162,17]].map(c=>`<circle cx="${c[0]}" cy="${c[1]}" r="${c[2]}" fill="${PAL.gold}" stroke="${PAL.goldD}" stroke-width="2.4"/><text x="${c[0]}" y="${c[1]+5}" text-anchor="middle" font-size="${c[2]*0.6}" font-weight="800" fill="#8A5E10">Rp</text>`).join("")}</g>
      `); },
      pestisida(){ return svgWrap(`
        ${sun(48,36,18)}
        <path d="M0 172 Q200 156 400 172 V215 H0Z" fill="${PAL.hill}"/>
        <g><rect x="88" y="58" width="66" height="96" rx="14" fill="${PAL.teal}"/><rect x="88" y="58" width="66" height="26" rx="13" fill="#174B35"/><rect x="104" y="38" width="34" height="16" rx="6" fill="${PAL.soilD}"/><rect x="102" y="98" width="38" height="30" rx="6" fill="#fff" opacity=".92"/><path d="M121 122 v-14 M121 112 q-7-7-12-6 M121 112 q7-7 12-6" stroke="${PAL.field2}" stroke-width="2.4" fill="none" stroke-linecap="round"/>
        <path d="M154 84 q44 4 62 34" stroke="${PAL.soilD}" stroke-width="5" fill="none" stroke-linecap="round"/><path d="M216 118 l16 26" stroke="${PAL.soilD}" stroke-width="5" stroke-linecap="round"/><path d="M232 144 l14 8" stroke="#174B35" stroke-width="6" stroke-linecap="round"/>
        <g fill="#7FC8BC">${[[258,140],[272,150],[256,158],[282,140],[268,132]].map(p=>`<circle cx="${p[0]}" cy="${p[1]}" r="3.4" opacity=".85"/>`).join("")}</g></g>
        <g><rect x="316" y="92" width="34" height="58" rx="8" fill="#fff" stroke="#B9C4BC" stroke-width="2"/><rect x="326" y="78" width="14" height="14" rx="3" fill="${PAL.red}"/><rect x="322" y="106" width="22" height="26" rx="3" fill="${PAL.sky}"/></g>
        <g stroke="${PAL.field2}" stroke-width="3" stroke-linecap="round"><path d="M292 176 v-26 M292 158 q-12-12-22-11 M292 158 q12-12 22-11" fill="none"/></g>
        <g><path d="M356 52 q14 8 14 8 v14 q0 14-14 20 q-14-6-14-20 v-14 q0 0 14-8Z" fill="${PAL.field}" opacity=".95"/><path d="M350 74 l5 5 9-10" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round"/></g>
      `); }
    };
    ILLUS.luasMini = ILLUS.luas; ILLUS.ranteMini = ILLUS.rante;

    /* ---------------- Data kategori & tools ---------------- */
    const CATEGORIES = [
      {id:"benih", name:"Benih & Persemaian", desc:"Kebutuhan benih padi per hektare", icon:'<path d="M12 21v-8m0 0c0-4 3-7 8-7 0 5-3 8-8 7Zm0-1C12 8 9 5 4 5c0 5 3 8 8 7Z" stroke="#328653" stroke-width="2" fill="none" stroke-linecap="round"/>', tool:"benih"},
      {id:"pupuk", name:"Pupuk & Nutrisi", desc:"Dosis & biaya pupuk sesuai rekomendasi", icon:'<path d="M5 21c6 0 9-2 11-6 4 1 5 4 5 6M5 21c0-6 2-9 6-11C10 6 12 3 17 3c0 6-2 9-6 11" stroke="#328653" stroke-width="2" fill="none" stroke-linecap="round"/>', tool:"pupuk"},
      {id:"lahan", name:"Luas & Pengukuran Lahan", desc:"Luas lahan & konversi rante per wilayah", icon:'<path d="M4 18 10 5l10 3-6 13Zm6-13v13M4 18h16" stroke="#328653" stroke-width="2" fill="none" stroke-linecap="round"/>', tool:"luas"},
      {id:"pestisida", name:"Pestisida & Pengendalian Hama", desc:"Dosis per tangki sesuai label produk", icon:'<path d="M9 21V11a3 3 0 0 1 6 0v2m-9-4h4V6h4v3m3 1 4-2m-4 5 5 1" stroke="#328653" stroke-width="2" fill="none" stroke-linecap="round"/>', tool:"pestisida"},
      {id:"biaya", name:"Biaya Produksi", desc:"Rincian total biaya tanam per musim", icon:'<path d="M4 8a2 2 0 0 1 2-2h13v3M4 8v9a2 2 0 0 0 2 2h14a1 1 0 0 0 1-1v-7a1 1 0 0 0-1-1H6a2 2 0 0 1-2-2Zm13 6h.01" stroke="#328653" stroke-width="2" fill="none" stroke-linecap="round"/>', tool:"biaya"},
      {id:"panen", name:"Hasil & Keuntungan Panen", desc:"Pendapatan, biaya, dan margin panen", icon:'<path d="M4 20V10m6 10V4m6 16v-7m4 7H2" stroke="#328653" stroke-width="2" fill="none" stroke-linecap="round"/>', tool:"untung"}
    ];

    const RANTE_STANDAR = [
      {id:"sumut", label:"Sumatera Utara — 1 rante = 400 m² (20 m × 20 m)", m2:400},
      {id:"aceh", label:"Aceh — 1 rante = 400 m²", m2:400},
      {id:"rantai", label:"Standar rantai ukur (chain) — 1 rante = 404,69 m²", m2:404.69},
      {id:"kustom", label:"Kustom — tentukan sendiri ukuran 1 rante di daerah Anda", m2:0}
    ];

    /* Rekomendasi dosis pupuk (kg/ha) — acuan rekomendasi pemupukan spesifik lokasi
       (Balitbangtan/Kementan) yang umum dipakai penyuluh; tetap dapat diubah pengguna. */
    const PUPUK_REKOMENDASI = {
      padi:   {urea:250, sp36:100, kcl:75,  npk:300, za:100, organik:2000},
      jagung: {urea:350, sp36:150, kcl:100, npk:300, za:150, organik:2000},
      cabai:  {urea:200, sp36:250, kcl:200, npk:400, za:150, organik:3000},
      tomat:  {urea:150, sp36:200, kcl:150, npk:350, za:100, organik:3000},
      bawang: {urea:200, sp36:200, kcl:150, npk:300, za:150, organik:3000},
      kedelai:{urea:50,  sp36:100, kcl:75,  npk:150, za:50,  organik:1000}
    };
    const TANAMAN_LABEL = {padi:"Padi Sawah", jagung:"Jagung", cabai:"Cabai", tomat:"Tomat", bawang:"Bawang Merah", kedelai:"Kedelai"};
    const PUPUK_LABEL = {urea:"Urea (46% N)", sp36:"SP-36 (36% P₂O₅)", kcl:"KCl (60% K₂O)", npk:"NPK Phonska 15-15-15", za:"ZA (21% N)", organik:"Pupuk Organik / Kompos"};

    const TOOLS = [
      { id:"benih", name:"Kalkulator Kebutuhan Benih Padi", short:"Benih Padi", cat:"Benih & Persemaian", illus:"benih",
        desc:"Hitung total benih padi yang dibutuhkan berdasarkan luas lahan, metode tanam, dan ukuran kemasan — lengkap dengan cadangan untuk penyulaman.",
        fields:[
          {id:"luas", label:"Luas Lahan", type:"number", def:"1", min:0.01, hint:"Masukkan angka luas sesuai satuan di samping."},
          {id:"satuan", label:"Satuan Luas", type:"select", def:"ha", options:[["ha","Hektare (ha)"],["m2","Meter persegi (m²)"],["rante","Rante (400 m²)"]]},
          {id:"perha", label:"Kebutuhan Benih per Hektare (kg/ha)", type:"number", def:"25", min:1, hint:"Acuan umum: tanam pindah 20–25 kg/ha, jajar legowo 25–30 kg/ha, tabela 40–60 kg/ha."},
          {id:"metode", label:"Metode Penanaman", type:"select", def:"tapin", options:[["tapin","Tanam Pindah (Tapin)"],["legowo","Jajar Legowo 2:1"],["tabela","Tebar Benih Langsung (Tabela)"],["hampa","Persemaian Kering / Dapog"]]},
          {id:"kemasan", label:"Ukuran Kemasan Benih (kg)", type:"select", def:"5", options:[["5","5 kg per kemasan"],["10","10 kg per kemasan"],["20","20 kg per kemasan"],["25","25 kg per kemasan"]]},
          {id:"cadangan", label:"Cadangan Benih untuk Penyulaman (%)", type:"number", def:"10", min:0, hint:"Umumnya 5–15% untuk mengganti bibit yang mati atau tidak tumbuh."}
        ],
        compute(v){
          const luasHa = v.satuan==="ha" ? v.luas : v.satuan==="m2" ? v.luas/10000 : v.luas*400/10000;
          const faktor = {tapin:1, legowo:1.15, tabela:1.0, hampa:0.9}[v.metode];
          const dasar = luasHa * v.perha * faktor;
          const cadangan = dasar * v.cadangan/100;
          const total = dasar + cadangan;
          const kemasan = Math.ceil(total / v.kemasan);
          return { highlight:{label:"Total Kebutuhan Benih", val:fmtNum(total,1)+" kg", sub:"Untuk lahan "+fmtNum(luasHa,3)+" ha · termasuk cadangan "+fmtNum(v.cadangan,0)+"%"},
            rows:[["Luas lahan (terkonversi)", fmtNum(luasHa,4)+" ha"],["Kebutuhan dasar (tanpa cadangan)", fmtNum(dasar,2)+" kg"],["Cadangan penyulaman ("+fmtNum(v.cadangan,0)+"%)", fmtNum(cadangan,2)+" kg"],["Jumlah kemasan "+v.kemasan+" kg", kemasan+" kemasan"],["Total benih jika membeli per kemasan", fmtNum(kemasan*v.kemasan,1)+" kg"]],
            note:{type:"info", title:"Catatan agronomis", text:"Daya tumbuh benih bersertifikat umumnya ≥80%. Bila daya tumbuh label lebih rendah, naikkan kebutuhan benih sebanding. Rendam dan peram benih 24–48 jam sebelum semai untuk keseragaman tumbuh."} };
        } },
      { id:"pupuk", name:"Kalkulator Kebutuhan Pupuk", short:"Pupuk", cat:"Pupuk & Nutrisi", illus:"pupuk",
        desc:"Hitung kebutuhan pupuk dan estimasi biayanya. Dosis awal mengikuti rekomendasi pemupukan spesifik lokasi per jenis tanaman — silakan sesuaikan dengan hasil uji tanah Anda.",
        fields:[
          {id:"luas", label:"Luas Lahan (ha)", type:"number", def:"1", min:0.01},
          {id:"tanaman", label:"Jenis Tanaman", type:"select", def:"padi", options:Object.entries(TANAMAN_LABEL)},
          {id:"pupuk", label:"Jenis Pupuk", type:"select", def:"urea", options:Object.entries(PUPUK_LABEL), hint:"Memilih tanaman/pupuk akan mengisi dosis rekomendasi secara otomatis (masih bisa diubah)."},
          {id:"dosis", label:"Dosis per Hektare (kg/ha)", type:"number", def:"250", min:1},
          {id:"harga", label:"Harga Pupuk per Kilogram (Rp)", type:"number", def:"2250", min:0, hint:"Contoh acuan: Urea bersubsidi ±Rp2.250/kg, NPK Phonska bersubsidi ±Rp2.300/kg (HET dapat berubah — cek kios resmi setempat)."},
          {id:"karung", label:"Isi per Karung (kg)", type:"select", def:"50", options:[["50","50 kg"],["25","25 kg"],["20","20 kg"],["10","10 kg (organik curah/sak kecil)"]]}
        ],
        compute(v){
          const total = v.luas * v.dosis;
          const karung = Math.ceil(total / v.karung);
          const biaya = total * v.harga;
          return { highlight:{label:"Total Kebutuhan "+PUPUK_LABEL[v.pupuk], val:fmtNum(total,1)+" kg", sub:"Untuk "+TANAMAN_LABEL[v.tanaman]+" seluas "+fmtNum(v.luas,2)+" ha"},
            rows:[["Dosis per hektare", fmtNum(v.dosis,0)+" kg/ha"],["Jumlah karung "+v.karung+" kg", karung+" karung"],["Estimasi biaya pupuk", fmtIDR(biaya)],["Biaya per hektare", fmtIDR(biaya/v.luas)]],
            note:{type:"info", title:"Dasar rekomendasi", text:"Dosis awal mengikuti kisaran rekomendasi pemupukan spesifik lokasi untuk "+TANAMAN_LABEL[v.tanaman]+". Rekomendasi paling tepat berasal dari uji tanah (PUTS/PUTK) atau perangkat uji tanah di BPP setempat. Aplikasikan pupuk berimbang bersama pupuk tunggal lain sesuai fase tumbuh tanaman."} };
        } },
      { id:"luas", name:"Kalkulator Luas Lahan", short:"Luas Lahan", cat:"Luas & Pengukuran Lahan", illus:"luas",
        desc:"Hitung luas bidang lahan berbentuk persegi, persegi panjang, segitiga, atau trapesium — hasil langsung dalam meter persegi, hektare, dan rante.",
        fields:[
          {id:"bentuk", label:"Bentuk Lahan", type:"seg", def:"panjang", options:[["persegi","Persegi"],["panjang","Persegi Panjang"],["segitiga","Segitiga"],["trapesium","Trapesium"]]},
          {id:"sisi", label:"Sisi (meter)", type:"number", def:"50", min:0.01, showIf:v=>v.bentuk==="persegi"},
          {id:"panjang", label:"Panjang (meter)", type:"number", def:"100", min:0.01, showIf:v=>v.bentuk==="panjang"||v.bentuk==="trapesium"},
          {id:"lebar", label:"Lebar (meter)", type:"number", def:"40", min:0.01, showIf:v=>v.bentuk==="panjang"},
          {id:"alas", label:"Alas Segitiga (meter)", type:"number", def:"60", min:0.01, showIf:v=>v.bentuk==="segitiga"},
          {id:"tinggi", label:"Tinggi Segitiga (meter)", type:"number", def:"40", min:0.01, showIf:v=>v.bentuk==="segitiga"},
          {id:"sisiA", label:"Sisi Sejajar A — Trapesium (meter)", type:"number", def:"80", min:0.01, showIf:v=>v.bentuk==="trapesium"},
          {id:"sisiB", label:"Sisi Sejajar B — Trapesium (meter)", type:"number", def:"60", min:0.01, showIf:v=>v.bentuk==="trapesium"},
          {id:"jarak", label:"Jarak antar Sisi Sejajar / Lebar (meter)", type:"number", def:"40", min:0.01, showIf:v=>v.bentuk==="trapesium"},
          {id:"ranteM2", label:"Standar Rante untuk Konversi", type:"select", def:"400", options:[["400","1 rante = 400 m² (Sumut & Aceh)"],["404.69","1 rante = 404,69 m² (rantai ukur)"],["625","1 rante = 625 m² (sebagian daerah)"]]}
        ],
        compute(v){
          let m2=0, rumus="";
          if(v.bentuk==="persegi"){ m2=v.sisi*v.sisi; rumus="sisi × sisi"; }
          else if(v.bentuk==="panjang"){ m2=v.panjang*v.lebar; rumus="panjang × lebar"; }
          else if(v.bentuk==="segitiga"){ m2=0.5*v.alas*v.tinggi; rumus="½ × alas × tinggi"; }
          else { m2=0.5*(v.sisiA+v.sisiB)*v.jarak; rumus="½ × (sisi A + sisi B) × jarak"; }
          return { highlight:{label:"Luas Lahan", val:fmtNum(m2,2)+" m²", sub:"Rumus: "+rumus},
            rows:[["Dalam hektare", fmtNum(m2/10000,4)+" ha"],["Dalam rante (1 rante = "+fmtNum(v.ranteM2,2)+" m²)", fmtNum(m2/v.ranteM2,3)+" rante"],["Dalam are (1 are = 100 m²)", fmtNum(m2/100,2)+" are"]],
            note:{type:"info", title:"Tips pengukuran", text:"Untuk lahan tidak beraturan, bagi lahan menjadi beberapa bidang sederhana, hitung satu per satu, lalu jumlahkan. Ukur sisi dengan meteran atau aplikasi GPS di HP untuk hasil lebih teliti."} };
        } },
      { id:"rante", name:"Konversi Hektare ke Rante", short:"Konversi Rante", cat:"Luas & Pengukuran Lahan", illus:"rante",
        desc:"Konversi dua arah antara hektare, rante, dan meter persegi dengan pilihan standar rante berdasarkan wilayah — karena ukuran rante tidak sama di seluruh Indonesia.",
        fields:[
          {id:"nilai", label:"Nilai yang Dikonversi", type:"number", def:"1", min:0},
          {id:"dari", label:"Dari Satuan", type:"select", def:"ha", options:[["ha","Hektare (ha)"],["rante","Rante"],["m2","Meter persegi (m²)"]]},
          {id:"standar", label:"Standar Rante Wilayah", type:"selectObj", def:"sumut", options:RUMPL => RUMPL, hint:"Pilih standar yang berlaku di daerah Anda."},
          {id:"kustomM2", label:"Ukuran 1 Rante Kustom (m²)", type:"number", def:"400", min:1, showIf:v=>v.standar==="kustom"}
        ],
        compute(v){
          const std = RANTE_STANDAR.find(s=>s.id===v.standar);
          const perRante = v.standar==="kustom" ? v.kustomM2 : std.m2;
          const m2 = v.dari==="ha" ? v.nilai*10000 : v.dari==="rante" ? v.nilai*perRante : v.nilai;
          return { highlight:{label:"Hasil Konversi", val:fmtNum(m2/perRante,3)+" rante", sub:fmtNum(v.nilai,3)+" "+({ha:"hektare",rante:"rante",m2:"m²"})[v.dari]+" dengan standar "+fmtNum(perRante,2)+" m²/rante"},
            rows:[["Dalam meter persegi", fmtNum(m2,2)+" m²"],["Dalam hektare", fmtNum(m2/10000,5)+" ha"],["Dalam rante", fmtNum(m2/perRante,3)+" rante"],["Dalam are", fmtNum(m2/100,2)+" are"],["Standar rante yang dipakai", "1 rante = "+fmtNum(perRante,2)+" m²"]],
            note:{type:"warn", title:"Ukuran rante berbeda tiap daerah", text:"Di Sumatera Utara dan Aceh, 1 rante umumnya 400 m² (20 m × 20 m). Standar rantai ukur internasional 1 rante = 404,69 m², dan sebagian daerah memakai ukuran lain. Selalu pastikan standar yang dipakai dalam transaksi jual-beli atau sewa lahan Anda."} };
        } },
      { id:"biaya", name:"Kalkulator Biaya Tanam", short:"Biaya Tanam", cat:"Biaya Produksi", illus:"biaya",
        desc:"Susun rincian biaya produksi satu musim tanam — dari benih sampai transportasi — dan lihat total serta biaya per hektare.",
        fields:[
          {id:"luas", label:"Luas Lahan (ha)", type:"number", def:"1", min:0.01},
          {id:"benih", label:"Biaya Benih (Rp)", type:"number", def:"375000", min:0},
          {id:"pupuk", label:"Biaya Pupuk (Rp)", type:"number", def:"1800000", min:0},
          {id:"pestisida", label:"Biaya Pestisida & Herbisida (Rp)", type:"number", def:"450000", min:0},
          {id:"tenaga", label:"Biaya Tenaga Kerja (Rp)", type:"number", def:"2500000", min:0, hint:"Tanam, pemeliharaan, panen, dan pascapanen."},
          {id:"olah", label:"Biaya Pengolahan Tanah (Rp)", type:"number", def:"1200000", min:0, hint:"Sewa traktor, bajak, atau olah tanah manual."},
          {id:"transport", label:"Biaya Transportasi (Rp)", type:"number", def:"300000", min:0},
          {id:"lain", label:"Biaya Tambahan Lainnya (Rp)", type:"number", def:"250000", min:0, hint:"Irigasi, sewa lahan (jika ada), karung, tali, dan lain-lain."}
        ],
        compute(v){
          const items=[["Benih",v.benih],["Pupuk",v.pupuk],["Pestisida & herbisida",v.pestisida],["Tenaga kerja",v.tenaga],["Pengolahan tanah",v.olah],["Transportasi",v.transport],["Biaya tambahan",v.lain]];
          const total=items.reduce((a,i)=>a+i[1],0);
          const rows=items.filter(i=>i[1]>0).map(i=>[i[0], fmtIDR(i[1])+" ("+fmtNum(total? i[1]/total*100:0,1)+"%)"]);
          return { highlight:{label:"Total Biaya Produksi", val:fmtIDR(total), sub:"Untuk lahan "+fmtNum(v.luas,2)+" ha dalam satu musim tanam"},
            rows: rows.concat([["Biaya per hektare", fmtIDR(total/v.luas)],["Komponen biaya terbesar", items.reduce((a,b)=>b[1]>a[1]?b:a)[0]]]),
            note:{type:"info", title:"Cara memakai angka ini", text:"Gunakan total biaya ini sebagai “Biaya Produksi” pada Kalkulator Keuntungan Panen untuk melihat estimasi keuntungan bersih dan titik impas usaha tani Anda."} };
        } },
      { id:"untung", name:"Kalkulator Keuntungan Panen", short:"Keuntungan Panen", cat:"Hasil & Keuntungan Panen", illus:"untung",
        desc:"Estimasi total panen, pendapatan kotor, keuntungan bersih, margin, dan harga titik impas (BEP) — dilengkapi grafik pendapatan vs biaya.",
        fields:[
          {id:"luas", label:"Luas Lahan (ha)", type:"number", def:"1", min:0.01},
          {id:"hasil", label:"Hasil Panen per Hektare (kg/ha)", type:"number", def:"5500", min:1, hint:"GKP padi sawah umumnya 4.500–6.500 kg/ha tergantung varietas dan musim."},
          {id:"harga", label:"Harga Jual per Kilogram (Rp)", type:"number", def:"6500", min:1, hint:"Gunakan harga gabah/komoditas yang berlaku di penggilingan atau tengkulak setempat."},
          {id:"biaya", label:"Total Biaya Produksi (Rp)", type:"number", def:"7500000", min:0, hint:"Belum tahu totalnya? Hitung dulu di Kalkulator Biaya Tanam."}
        ],
        compute(v){
          const totalKg=v.luas*v.hasil;
          const pendapatan=totalKg*v.harga;
          const untung=pendapatan-v.biaya;
          const margin=pendapatan? untung/pendapatan*100:0;
          const bepKg=v.harga? v.biaya/v.harga:0;
          const bepHarga=totalKg? v.biaya/totalKg:0;
          const max=Math.max(pendapatan, v.biaya, Math.max(untung,0))||1;
          const bar=(val,color,label)=>`<div style="margin:8px 0"><div style="display:flex;justify-content:space-between;font-size:.82rem;font-weight:600"><span>${label}</span><span>${fmtIDR(val)}</span></div><div style="background:var(--surface-2);border-radius:8px;height:16px;overflow:hidden"><div style="width:${Math.max(0,val/max*100)}%;height:100%;background:${color};border-radius:8px"></div></div></div>`;
          const chart=`<div class="chart-box"><b style="font-size:.9rem">Grafik Pendapatan vs Biaya</b>${bar(pendapatan,"#328653","Pendapatan kotor")}${bar(v.biaya,"#C4552E","Total biaya")}${bar(Math.max(untung,0),"#A4C96B","Keuntungan bersih")}</div>`;
          return { highlight:{label: untung>=0?"Estimasi Keuntungan Bersih":"Estimasi Kerugian", val:fmtIDR(untung), sub:"Margin keuntungan "+fmtNum(margin,1)+"% dari pendapatan"},
            rows:[["Total hasil panen", fmtNum(totalKg,0)+" kg ("+fmtNum(totalKg/1000,2)+" ton)"],["Pendapatan kotor", fmtIDR(pendapatan)],["Total biaya produksi", fmtIDR(v.biaya)],["Titik impas (BEP) volume", fmtNum(bepKg,0)+" kg panen"],["Titik impas (BEP) harga", fmtIDR(bepHarga)+" /kg"]],
            chart,
            note:{type: untung>=0?"info":"warn", title: untung>=0?"Panen diperkirakan untung":"Panen diperkirakan rugi", text: untung>=0?"Selama harga jual di atas "+fmtIDR(bepHarga)+"/kg dan hasil mencapai "+fmtNum(bepKg,0)+" kg, usaha tani Anda berada di atas titik impas.":"Hasil atau harga saat ini belum menutup biaya. Pertimbangkan menekan biaya terbesar, menaikkan produktivitas, atau mencari saluran penjualan dengan harga lebih baik."} };
        } },
      { id:"pestisida", name:"Kalkulator Dosis Pestisida", short:"Dosis Pestisida", cat:"Pestisida & Pengendalian Hama", illus:"pestisida",
        desc:"Hitung kebutuhan produk per tangki dan total satu lahan berdasarkan dosis pada label resmi produk yang Anda pakai — bukan dosis karangan.",
        fields:[
          {id:"produk", label:"Nama Produk (sesuai label)", type:"text", def:"", placeholder:"cth: Insektisida X 500 EC", hint:"Tulis nama produk persis seperti pada kemasan."},
          {id:"aktif", label:"Bahan Aktif & Formulasi", type:"text", def:"", placeholder:"cth: Deltametrin 25 g/L — EC", hint:"Contoh formulasi: EC, SC, WP, GR. Lihat pada label produk."},
          {id:"mode", label:"Cara Dosis pada Label", type:"seg", def:"perha", options:[["perha","Dosis per Hektare"],["pertangki","Dosis per Tangki"]]},
          {id:"dosisHa", label:"Dosis Label per Hektare (ml atau g /ha)", type:"number", def:"500", min:0.01, showIf:v=>v.mode==="perha", hint:"Salin angka dosis dari label resmi produk untuk hama sasaran Anda."},
          {id:"dosisTangki", label:"Dosis Label per Tangki (ml atau g /tangki)", type:"number", def:"30", min:0.01, showIf:v=>v.mode==="pertangki"},
          {id:"tangki", label:"Volume Tangki Semprot (liter)", type:"number", def:"16", min:1, hint:"Knapsack sprayer umumnya 14–16 liter."},
          {id:"volumeHa", label:"Volume Semprot per Hektare (liter/ha)", type:"number", def:"400", min:1, showIf:v=>v.mode==="perha", hint:"Volume air pelarut per hektare; umumnya 300–500 L/ha untuk aplikasi darat."},
          {id:"luas", label:"Luas Lahan yang Disemprot (ha)", type:"number", def:"1", min:0.01}
        ],
        compute(v){
          let perTangki, tangkiPerHa, totalTangki, totalProduk;
          if(v.mode==="perha"){ tangkiPerHa=v.volumeHa/v.tangki; perTangki=v.dosisHa/tangkiPerHa; totalTangki=tangkiPerHa*v.luas; totalProduk=v.dosisHa*v.luas; }
          else { perTangki=v.dosisTangki; totalTangki=null; totalProduk=null; tangkiPerHa=null; }
          const rows=[];
          rows.push(["Produk", v.produk||"— (isi nama produk)"]);
          if(v.aktif) rows.push(["Bahan aktif & formulasi", v.aktif]);
          rows.push(["Kebutuhan produk per tangki", fmtNum(perTangki,2)+" ml/g"]);
          if(v.mode==="perha"){
            rows.push(["Jumlah tangki per hektare", fmtNum(tangkiPerHa,1)+" tangki"]);
            rows.push(["Total tangki untuk "+fmtNum(v.luas,2)+" ha", fmtNum(totalTangki,1)+" tangki (± "+Math.ceil(totalTangki)+" tangki penuh)"]);
            rows.push(["Total kebutuhan produk", fmtNum(totalProduk,0)+" ml/g (± "+fmtNum(totalProduk/1000,2)+" liter/kg)"]);
            rows.push(["Total volume air pelarut", fmtNum(v.volumeHa*v.luas,0)+" liter"]);
          } else {
            rows.push(["Catatan", "Mode per tangki: kalikan dosis per tangki dengan jumlah tangki yang Anda habiskan di lahan. Untuk total kebutuhan pasti, gunakan mode Dosis per Hektare bila label mencantumkannya."]);
          }
          return { highlight:{label:"Produk per Tangki ("+fmtNum(v.tangki,0)+" L)", val:fmtNum(perTangki,2)+" ml/g", sub: v.mode==="perha" ? "Total produk: "+fmtNum(totalProduk,0)+" ml/g untuk "+fmtNum(v.luas,2)+" ha" : "Sesuai dosis label per tangki"},
            rows,
            note:{type:"warn", title:"Peringatan keselamatan — wajib dibaca", text:"Selalu ikuti label resmi produk dan rekomendasi POPT/penyuluh setempat; jangan menaikkan dosis melebihi label. Gunakan APD lengkap (masker, sarung tangan, baju lengan panjang), jangan menyemprot melawan arah angin, jauhkan dari anak dan sumber air, patuhi masa henti (PHI) sebelum panen, dan simpan produk terkunci jauh dari makanan."} };
        } }
    ];
    const toolById = id => TOOLS.find(t=>t.id===id);


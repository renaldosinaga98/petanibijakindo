      .calc-layout{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start;padding-bottom:20px}
      .panel{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:26px}
      .panel h2{font-size:1.12rem;font-weight:800;line-height:1.3;letter-spacing:-.01em;margin-bottom:5px}
      .panel .sub{color:var(--ink-soft);font-size:.9rem;line-height:1.55;margin:0 0 20px}
      /* Form standar untuk semua kalkulator: label → input lebar penuh → hint → error */
      #calc-fields{display:flex;flex-direction:column;gap:18px}
      .field{margin:0;display:flex;flex-direction:column;min-width:0}
      .field label{display:block;font-weight:700;font-size:.875rem;line-height:1.4;color:var(--ink);margin:0 0 7px}
      .field input,.field select{display:block;width:100%;height:46px;min-height:46px;border:1.5px solid var(--input-border);border-radius:10px;padding:10px 13px;font-family:inherit;font-size:1rem;line-height:1.45;background:var(--input-bg);color:var(--ink);font-variant-numeric:tabular-nums}
      .field input::placeholder{color:var(--ink-soft);opacity:.7;font-size:.92rem}
      .field input:focus,.field select:focus{border-color:var(--agri);outline:none;box-shadow:0 0 0 3px color-mix(in srgb, var(--lime) 35%, transparent)}
      .field .hint{font-weight:500;color:var(--ink-soft);font-size:.8rem;line-height:1.5;margin-top:6px}
      .field .err{display:none;color:var(--danger);font-size:.8rem;line-height:1.45;font-weight:600;margin-top:6px}
      .field .err[hidden]{display:none!important}
      .field.invalid input,.field.invalid select{border-color:var(--danger);background:var(--danger-soft)}
      .field.invalid .err{display:block}
      .field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
      .calc-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
      .calc-actions .btn{min-height:48px}
      .calc-actions .btn-primary{flex:1 1 200px;justify-content:center}
      .calc-actions .btn-ghost{flex:0 1 auto;justify-content:center}
      .seg{display:flex;gap:8px;flex-wrap:wrap}
      .seg button{border:1.5px solid var(--input-border);background:var(--input-bg);color:var(--ink);border-radius:10px;padding:10px 16px;font-weight:700;font-size:.9rem;min-height:44px;line-height:1.3}
      .seg button.on{background:var(--agri);color:#fff;border-color:var(--agri)}
      html[data-theme="dark"] .seg button.on{background:var(--agri);border-color:var(--agri)}
      .result-empty{color:var(--ink-soft);text-align:center;padding:40px 12px;font-size:.95rem;line-height:1.6}
      .result-empty .big{font-size:2rem;margin-bottom:8px}
      .res-highlight{background:linear-gradient(145deg,#27864F,#3E9E5F);color:#fff;border-radius:16px;padding:22px;margin-bottom:14px}
      .res-highlight small{opacity:.88;font-weight:700;font-size:.78rem;letter-spacing:.06em;text-transform:uppercase;display:block;margin-bottom:5px}
      .res-highlight .val{font-size:clamp(1.7rem,4vw,2.1rem);font-weight:800;letter-spacing:-.02em;line-height:1.15;font-variant-numeric:tabular-nums;overflow-wrap:break-word}
      .res-highlight .val2{font-size:.95rem;opacity:.94;margin-top:5px;line-height:1.5}
      .res-rows{display:flex;flex-direction:column}
      .res-row{display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:16px;align-items:start}
      .res-row{padding:11px 2px;border-bottom:1px dashed var(--line);font-size:.93rem;line-height:1.5}
      .res-row:last-child{border-bottom:0}
      .res-row span{color:var(--ink-soft);min-width:0;overflow-wrap:break-word}
      .res-row b{text-align:right;font-weight:700;font-variant-numeric:tabular-nums;max-width:16rem;overflow-wrap:break-word}
      .res-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:20px}
      .res-actions .btn{justify-content:center}
      .note-box{border-radius:14px;padding:14px 16px;font-size:.88rem;line-height:1.65;margin-top:16px;text-align:left}
      .note-info{background:var(--chip);color:var(--ink)}
      .note-warn{background:var(--warn-bg);color:var(--warn-ink)}
      .note-box b{display:block;margin-bottom:3px}
      .chart-box{margin-top:16px}
      .history{margin-top:22px}
      .history h3{font-size:.95rem;font-weight:800;margin-bottom:10px}
      .hist-item{display:flex;justify-content:space-between;align-items:flex-start;gap:8px 14px;flex-wrap:wrap;background:var(--surface-2);border-radius:12px;padding:11px 14px;font-size:.86rem;line-height:1.5;margin-bottom:8px}
      .hist-item b{display:block;font-size:.88rem}
      .hist-item span{color:var(--ink-soft)}
      .hist-item time{color:var(--ink-soft);font-size:.76rem;white-space:nowrap}

      /* ---------- Articles ---------- */
      .filter-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px}
      .filter-row button{border:1.5px solid var(--line);background:var(--surface);color:var(--ink);border-radius:99px;padding:8px 16px;font-weight:700;font-size:.85rem;min-height:38px}
      .filter-row button.on{background:var(--agri);color:#fff;border-color:var(--agri)}
      .art-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
      .art-card{background:var(--surface);border:1px solid var(--line);border-radius:22px;overflow:hidden;display:flex;flex-direction:column;color:var(--ink);transition:transform .18s ease, box-shadow .18s ease}
      .art-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);text-decoration:none}
      .art-thumb{aspect-ratio:16/9;position:relative;overflow:hidden}
      .art-thumb svg{width:100%;height:100%}
      .art-body{padding:20px 22px 22px;display:flex;flex-direction:column;gap:9px;flex:1}
      .art-body .meta{font-size:.76rem;font-weight:700;color:var(--agri);letter-spacing:.05em;text-transform:uppercase}
      .art-body h3{font-size:1.05rem;font-weight:800;line-height:1.35}
      .art-body p{color:var(--ink-soft);font-size:.88rem;line-height:1.6;margin:0;flex:1}
      .art-body .byline{font-size:.8rem;color:var(--ink-soft);margin-top:3px;padding-top:11px;border-top:1px solid var(--line)}
      .article-wrap{max-width:780px;margin:0 auto;padding-bottom:10px}
      .article-wrap h1{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:800;letter-spacing:-.02em;margin:10px 0 12px}
      .article-hero{border-radius:22px;overflow:hidden;border:1px solid var(--line);margin:20px 0}
      .article-hero svg{width:100%;height:auto}
      .toc{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:18px 22px;margin:0 0 26px}
      .toc b{display:block;margin-bottom:8px}
      .toc ol{margin:0;padding-left:20px}
      .toc li{margin:4px 0}
      .article-body h2{font-size:1.35rem;font-weight:800;margin:30px 0 10px}
      .article-body p{margin:0 0 14px;color:var(--ink)}
      .article-body ul{margin:0 0 14px;padding-left:20px}
      .article-body li{margin:5px 0}
      .refs{background:var(--surface-2);border-radius:16px;padding:18px 22px;font-size:.88rem;margin-top:28px}
      .refs b{display:block;margin-bottom:6px}
      .refs ul{margin:0;padding-left:18px}

      /* ---------- Pages ---------- */
      .page-wrap{max-width:820px;margin:0 auto;padding-bottom:10px}
      .page-wrap h1{font-size:clamp(1.8rem,4vw,2.5rem);font-weight:800;letter-spacing:-.02em;margin:8px 0 14px}
      .page-wrap h2{font-size:1.25rem;font-weight:800;margin:28px 0 9px}
      .page-wrap p{margin:0 0 13px}
      .page-wrap ul{margin:0 0 13px;padding-left:20px}
      .page-wrap li{margin:5px 0}
      .team-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:22px 0}
      .team-card{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:24px}
      .avatar{width:60px;height:60px;border-radius:50%;background:linear-gradient(145deg,var(--agri),var(--lime));display:grid;place-items:center;color:#fff;font-weight:800;font-size:1.25rem;margin-bottom:12px}
      .contact-card{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:26px;display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin:20px 0}
      .ad-slot{display:block;border:1.5px dashed var(--line);border-radius:16px;padding:20px;margin:34px 0 6px;background:var(--surface);min-height:64px}

      /* ---------- Footer ---------- */
      footer.site{background:linear-gradient(180deg,#EBF3DB,#E0EECB);color:#39543F;margin-top:70px;border-top:1px solid var(--line)}
      html[data-theme="dark"] footer.site{background:#0B1F14;color:#C9DCC0;border-top:1px solid var(--line)}
      html[data-theme="dark"] footer.site h4{color:#fff}
      html[data-theme="dark"] footer.site a{color:#C9DCC0}
      html[data-theme="dark"] footer.site a:hover{color:#fff}
      html[data-theme="dark"] .foot-bottom{border-top:1px solid rgba(255,255,255,.14)}
      .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:30px;padding:48px 0 34px}
      footer.site h4{color:#1C5A3F;font-size:.95rem;margin:0 0 13px}
      footer.site a{color:#3D6148;display:block;padding:6px 0;font-size:.9rem;line-height:1.5}
      #foot-tools{display:flex;flex-direction:column;gap:2px}
      #foot-tools a{display:block;padding:6px 0}
      footer.site a:hover{color:#17452F}
      footer.site p{font-size:.9rem;line-height:1.65;margin:0 0 12px}
      .foot-bottom{border-top:1px solid rgba(28,90,63,.16);padding:18px 0 24px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:.84rem}

      .toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,80px);background:#256B45;color:#fff;padding:13px 22px;border-radius:13px;font-weight:700;font-size:.9rem;box-shadow:var(--shadow-lg);z-index:100;transition:transform .3s ease, opacity .3s ease, visibility .3s;max-width:92vw;text-align:center;opacity:0;visibility:hidden;pointer-events:none}
      .toast.show{transform:translate(-50%,0);opacity:1;visibility:visible}
      .view{display:none}
      .view.active{display:block}
      .how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
      .how-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:22px}
      .how-card .num{width:38px;height:38px;border-radius:50%;background:var(--agri);color:#fff;display:grid;place-items:center;font-weight:800;margin-bottom:12px}
      .how-card h3{font-size:1rem;font-weight:800;margin-bottom:6px}
      .how-card p{color:var(--ink-soft);font-size:.9rem;margin:0}

      /* ---------- Professional polish & new sections ---------- */
      .trust-strip{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
      .trust-strip span{display:inline-flex;align-items:center;gap:7px;background:var(--surface);border:1px solid var(--line);border-radius:99px;padding:7px 13px;font-size:.8rem;font-weight:700;color:var(--ink)}
      .trust-strip svg{flex-shrink:0}
      .section-band{background:var(--surface);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
      .crop-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
      .crop-card{background:var(--surface);border:1px solid var(--line);border-radius:20px;overflow:hidden;color:var(--ink);display:flex;flex-direction:column;transition:transform .18s ease, box-shadow .18s ease}
      .section-band .crop-card{background:var(--bg)}
      .crop-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);text-decoration:none}
      .crop-thumb{display:block;aspect-ratio:16/8.2;overflow:hidden}
      .crop-thumb svg{width:100%;height:100%}
      .tool-art img,.crop-thumb img,.art-thumb img{display:block;width:100%;height:100%;object-fit:cover}
      .article-hero img,.calc-head .art img,.hero-art .art-card img{display:block;width:100%;height:auto}
      .crop-body{display:flex;flex-direction:column;gap:7px;padding:16px 18px 18px;flex:1}
      .crop-body .crop-name{display:block;font-size:.98rem;font-weight:800;line-height:1.35;color:var(--ink)}
      .crop-body .crop-note{display:block;color:var(--ink-soft);font-size:.83rem;line-height:1.6;margin:0;flex:1}
      .crop-body .go{display:inline-block;align-self:flex-start;color:var(--agri);font-weight:800;font-size:.82rem;line-height:1.4;margin-top:8px;padding-top:2px}
      .eeat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
      .eeat-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:22px}
      .eeat-card .ic{width:44px;height:44px;border-radius:12px;background:var(--chip);display:grid;place-items:center;margin-bottom:12px}
      .eeat-card h3{font-size:1rem;font-weight:800;margin-bottom:6px}
      .eeat-card p{color:var(--ink-soft);font-size:.89rem;margin:0}
      .faq-list{display:flex;flex-direction:column;gap:10px;max-width:860px}
      .faq-item{background:var(--surface);border:1px solid var(--line);border-radius:16px;overflow:hidden}
      .faq-item summary{cursor:pointer;padding:17px 20px;font-weight:800;font-size:.97rem;list-style:none;display:flex;justify-content:space-between;gap:14px;align-items:center;min-height:44px}
      .faq-item summary::-webkit-details-marker{display:none}
      .faq-item summary::after{content:"+";font-size:1.35rem;color:var(--agri);font-weight:800;line-height:1}
      .faq-item[open ] summary::after{content:"–"}
      .faq-item .faq-a{padding:2px 20px 19px;color:var(--ink-soft);font-size:.93rem;line-height:1.65}
      .faq-item .faq-a p{margin:0}
      .author-box{display:flex;gap:16px;background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:22px;margin-top:30px;flex-wrap:wrap;align-items:flex-start}
      .author-box .avatar{margin:0}
      .author-box b{font-size:1rem}
      .author-box p{color:var(--ink-soft);font-size:.89rem;margin:4px 0 0}
      .pdf-badge{display:inline-flex;align-items:center;gap:7px;background:#FDF0E3;color:#8A4B12;border:1px solid #F0D9B5;border-radius:99px;padding:5px 12px;font-size:.74rem;font-weight:800;letter-spacing:.02em}
      html[data-theme="dark"] .pdf-badge{background:#3A2A12;color:#F2C078;border-color:#5C451C}
      .calc-pro{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
      .calc-pro span{display:inline-flex;gap:7px;align-items:center;font-size:.8rem;font-weight:700;color:var(--ink-soft)}
      .sched-note{background:var(--chip);border-radius:14px;padding:14px 16px;font-size:.9rem;margin:0 0 16px}
      .sched-table{width:100%;border-collapse:collapse;background:var(--surface);border:1px solid var(--line);border-radius:16px;overflow:hidden;font-size:.9rem;margin:0 0 8px}
      .sched-table th{background:var(--agri);color:#fff;text-align:left;padding:11px 14px;font-size:.8rem;letter-spacing:.03em}
      .sched-table td{padding:11px 14px;border-top:1px solid var(--line);vertical-align:top}
      .sched-table td:first-child{white-space:nowrap;font-weight:700;color:var(--forest)}
      html[data-theme="dark"] .sched-table td:first-child{color:var(--lime)}
      .sched-badge{display:inline-block;background:var(--warn-bg);color:var(--warn-ink);border-radius:99px;padding:3px 10px;font-size:.74rem;font-weight:800;white-space:nowrap}
      @media (max-width:760px){ .sched-table,.sched-table tbody,.sched-table tr,.sched-table td{display:block;width:100%} .sched-table thead{display:none} .sched-table tr{border-top:1px solid var(--line);padding:8px 0} .sched-table td{border-top:0;padding:4px 14px} .sched-table td:first-child{padding-top:10px} }
      @media (max-width:1020px){ .crop-grid{grid-template-columns:repeat(2,1fr)} .eeat-grid{grid-template-columns:1fr} }
      @media (max-width:760px){ .crop-grid{grid-template-columns:1fr 1fr} .crop-body{padding:13px 15px 15px;gap:6px} .crop-body .crop-note{font-size:.8rem;line-height:1.55} .crop-body .go{margin-top:6px} }

      @media (max-width:1020px){
        .tool-grid,.art-grid,.cat-grid{grid-template-columns:repeat(2,1fr)}
        .hero-grid{grid-template-columns:1fr;gap:30px}
        .calc-head{grid-template-columns:1fr}
        .calc-head .art{max-width:460px}
        .foot-grid{grid-template-columns:1fr 1fr}
      }
      @media (max-width:760px){
        nav.main{display:none}
        .burger{display:grid}
        .nav{gap:10px}
        .brand{gap:9px;min-width:0}
        .brand .logo-badge{width:38px;height:38px;border-radius:11px}
        .brand b{font-size:.9rem;white-space:nowrap}
        .brand small{display:none}
        .nav-actions{gap:6px;margin-left:auto}
        .icon-btn{width:38px;height:38px;border-radius:10px}
        .tool-grid,.art-grid,.cat-grid,.how-grid{grid-template-columns:1fr}
        .calc-layout{grid-template-columns:1fr}
        .panel{padding:20px 18px}
        #calc-fields{gap:16px}
        .calc-actions{flex-direction:column}
        .calc-actions .btn{width:100%;flex:none}
        .res-actions .btn{flex:1 1 100%}
        .stats{grid-template-columns:repeat(2,1fr)}
        .team-grid{grid-template-columns:1fr}
        .field-row{grid-template-columns:1fr}
        .chip-a{left:2px}.chip-b{right:2px}
        .hero{padding-top:36px}
        .tool-card:hover,.art-card:hover,.crop-card:hover,.cat-card:hover{transform:none;box-shadow:var(--shadow)}
        .seg{display:grid;grid-template-columns:1fr 1fr;gap:8px}
        .seg button{width:100%;padding:10px 8px}
        .res-row{column-gap:12px;padding:10px 0}
        .res-row b{max-width:11.5rem}
        .res-highlight{padding:18px}
        .hist-item{flex-direction:column;gap:2px}
        .hist-item time{white-space:normal}
        .hero-art .art-card{box-shadow:var(--shadow)}
        section.block{padding:40px 0 6px}
        .panel{border-radius:18px}
        .foot-grid{grid-template-columns:1fr;gap:22px}
      }
      @media (prefers-reduced-motion:reduce){
        *{transition:none!important;scroll-behavior:auto!important}
      }
    </style>

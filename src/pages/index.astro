      privasi:{ title:"Kebijakan Privasi", nav:"", html:`
        <div class="crumb"><a href="#/">Beranda</a> <span>›</span> <span>Kebijakan Privasi</span></div>
        <h1>Kebijakan Privasi</h1>
        <p><i>Terakhir diperbarui: 12 November 2026. Berlaku untuk website Petani Bijak Indonesia yang dikelola Renaldo Sinaga bersama Team Vexora.</i></p>

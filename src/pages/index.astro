    const ARTICLES = [
      { slug:"jajar-legowo-padi", cat:"Budidaya Padi", thumb:"padi", title:"Jajar Legowo 2:1: Cara Tanam Padi yang Terbukti Menaikkan Hasil", author:"Renaldo Sinaga", date:"2026-10-28", read:"7 menit baca",
        excerpt:"Sistem tanam jajar legowo memberi ruang cahaya dan udara lebih baik bagi tanaman pinggir. Pelajari pola, jarak tanam, dan kebutuhan benihnya sebelum musim tanam dimulai.",
        body:[
          ["Apa Itu Jajar Legowo?",["Jajar legowo adalah cara tanam padi dengan pola barisan berselang: beberapa baris tanaman diikuti satu baris kosong (lorong). Pola 2:1 berarti dua baris tanaman lalu satu lorong kosong. Lorong ini membuat semua tanaman berada di posisi “pinggir” yang mendapat cahaya matahari dan sirkulasi udara lebih baik.","Tanaman pinggir terbukti berproduksi lebih tinggi karena fotosintesis lebih optimal dan serangan penyakit lebih rendah. Berbagai pengujian Balitbangtan menunjukkan kenaikan hasil gabah sekitar 10–30% dibanding tanam tegel biasa, tergantung varietas dan kesuburan tanah."]],
          ["Pola dan Jarak Tanam 2:1",["Untuk legowo 2:1, gunakan jarak tanam 25 cm × 12,5 cm × 50 cm: jarak antarbaris dalam pasangan 25 cm, jarak dalam baris 12,5 cm, dan lebar lorong 50 cm. Populasi tanaman menjadi sekitar 213.000 rumpun per hektare — lebih banyak daripada tegel 25 × 25 cm yang hanya 160.000 rumpun.","Karena populasi bertambah, kebutuhan benih ikut naik. Hitung kebutuhan benih lahan Anda dengan Kalkulator Kebutuhan Benih Padi kami dan pilih metode “Jajar Legowo 2:1” agar cadangan penyulaman ikut terhitung."]],
          ["Langkah Penerapan di Lapangan",["Buat garis tanam (caplak) mengikuti pola legowo sebelum tanam agar barisan rapi. Tanam bibit muda berumur 15–21 hari setelah semai, 1–3 batang per lubang, dangkal 1–2 cm agar anakan cepat keluar.","Manfaatkan lorong kosong untuk pemeliharaan: penyiangan, pemupukan susulan, dan penyemprotan menjadi lebih mudah tanpa menginjak tanaman. Lorong juga memudahkan pengendalian keong mas dan tikus."]],
          ["Hal yang Perlu Diperhatikan",["Legowo menuntut ketelitian saat tanam dan tenaga kerja sedikit lebih banyak di awal. Latih tim tanam dengan contoh satu petak terlebih dahulu. Pada lahan yang sangat subur, imbangi dengan pemupukan berimbang agar tanaman tidak terlalu rimbun dan rebah."]]
        ],
        refs:["Badan Penelitian dan Pengembangan Pertanian (Balitbangtan), Kementerian Pertanian — Pedoman Umum PTT Padi Sawah.","Balai Besar Penelitian Tanaman Padi (BB Padi), Sukamandi — Teknologi Jajar Legowo Super."] },
      { slug:"pemupukan-berimbang-padi", cat:"Pemupukan", thumb:"pupuk", title:"Pemupukan Berimbang Padi Sawah: Dosis, Waktu, dan Cara Aplikasi", author:"Renaldo Sinaga", date:"2026-10-15", read:"8 menit baca",
        excerpt:"Pupuk mahal kalau salah dosis dan salah waktu. Panduan ini merangkum rekomendasi dosis NPK untuk padi sawah, pembagian waktu aplikasi, dan cara membaca kebutuhan hara tanah.",
        body:[
          ["Prinsip Pemupukan Berimbang",["Pemupukan berimbang berarti memberi hara sesuai kebutuhan tanaman dan ketersediaan hara di tanah — tidak kurang, tidak berlebih. Untuk padi sawah, kisaran rekomendasi umum adalah Urea 200–250 kg/ha, SP-36 75–100 kg/ha, dan KCl 50–100 kg/ha, atau diganti sebagian dengan NPK majemuk sekitar 300 kg/ha ditambah Urea susulan.","Angka pasti bergantung hasil uji tanah. Gunakan Perangkat Uji Tanah Sawah (PUTS) atau layanan BPP setempat untuk rekomendasi spesifik lokasi — Kalkulator Kebutuhan Pupuk kami sudah memakai kisaran ini sebagai titik awal."]],
          ["Waktu Aplikasi yang Tepat",["Berikan seluruh SP-36 dan KCl (atau sebagian) sebagai pupuk dasar saat tanam sampai 7 hari setelah tanam (HST). Urea diberikan bertahap: sepertiga sebagai dasar, sisanya pada 25–30 HST dan 40–45 HST mengikuti warna daun.","Gunakan Bagan Warna Daun (BWD) untuk menentukan susulan Urea: bila warna daun di bawah skala 4 pada fase kritis, tambahkan Urea 50–75 kg/ha. Cara ini mencegah pemupukan nitrogen berlebih yang membuat tanaman rentan hama dan rebah."]],
          ["Kesalahan yang Sering Terjadi",["Menabur semua pupuk sekaligus di awal, memupuk saat daun masih basah oleh embun (pupuk menempel dan menguap), dan mengabaikan bahan organik. Kembalikan jerami ke lahan atau beri pupuk organik ±2 ton/ha untuk menjaga kesehatan tanah jangka panjang."]]
        ],
        refs:["Kementerian Pertanian — Rekomendasi Pemupukan Spesifik Lokasi (Permentan tentang Rekomendasi Pemupukan N, P, K pada Padi Sawah Spesifik Lokasi).","Balitbangtan — Petunjuk Teknis Pengelolaan Hara Spesifik Lokasi (PHSL)."] },
      { slug:"budidaya-jagung-lahan-kering", cat:"Budidaya Jagung", thumb:"jagung", title:"Budidaya Jagung di Lahan Kering: Dari Olah Tanah sampai Panen", author:"Tim Vexora", date:"2026-09-30", read:"9 menit baca",
        excerpt:"Jagung lahan kering bisa menembus 6–8 ton pipilan per hektare dengan pengelolaan yang tepat. Berikut tahapan lengkapnya: jarak tanam, pemupukan bertahap, dan pengendalian ulat grayak.",
        body:[
          ["Persiapan Lahan dan Jarak Tanam",["Olah tanah minimum atau tanpa olah tanah (TOT) dengan membersihkan gulma terlebih dahulu. Jarak tanam yang dianjurkan 70 cm × 20 cm (satu lubang satu tanaman) atau 75 cm × 40 cm (dua tanaman per lubang), populasi sekitar 66.000–71.000 tanaman per hektare.","Tanam di awal musim hujan saat tanah sudah cukup lembap. Kedalaman lubang 3–5 cm, tutup dengan tanah gembur atau pupuk kandang."]],
          ["Pemupukan Bertahap",["Rekomendasi umum jagung hibrida: Urea 300–350 kg/ha, SP-36 150 kg/ha, dan KCl 100 kg/ha (atau NPK 300 kg/ha + Urea susulan). Berikan SP-36 dan KCl seluruhnya saat tanam; Urea dibagi tiga: saat tanam, umur 21–28 hari, dan 40–45 hari setelah tanam.","Hitung kebutuhan dan biaya pupuk lahan Anda dengan Kalkulator Kebutuhan Pupuk — pilih tanaman “Jagung” agar dosis awal otomatis mengikuti rekomendasi."]],
          ["Pengendalian Ulat Grayak (Spodoptera frugiperda)",["Periksa tanaman sejak umur 7 hari. Tanda serangan: serbuk seperti serbuk gergaji di pucuk dan lubang gerekan pada daun muda. Kendalikan secara terpadu: tanam serempak, pasang perangkap feromon, manfaatkan musuh alami, dan gunakan insektisida berbahan aktif yang terdaftar hanya bila ambang kendali terlampaui, dengan dosis sesuai label — hitung kebutuhannya di Kalkulator Dosis Pestisida kami."]],
          ["Panen dan Pascapanen",["Panen saat kelobot mengering dan biji mengeras (kadar air ±30%), ditandai lapisan hitam (black layer) pada pangkal biji. Keringkan pipilan hingga kadar air 14% sebelum disimpan atau dijual agar harga maksimal dan bebas aflatoksin."]]
        ],
        refs:["Balai Penelitian Tanaman Serealia (Balitsereal), Maros — Pengelolaan Tanaman Terpadu Jagung.","Direktorat Jenderal Tanaman Pangan, Kementan — Pedoman Budidaya Jagung."] },
      { slug:"pengendalian-hama-terpadu", cat:"Pengendalian Hama", thumb:"hama", title:"Pengendalian Hama Terpadu (PHT): Semprot Lebih Sedikit, Hasil Lebih Sehat", author:"Renaldo Sinaga", date:"2026-09-12", read:"7 menit baca",
        excerpt:"PHT mengajarkan petani mengamati dulu sebelum menyemprot. Kenali ambang kendali wereng, penggerek batang, dan tikus — plus cara memakai pestisida secara bijak bila memang diperlukan.",
        body:[
          ["Empat Prinsip PHT",["Budidaya tanaman sehat, pelestarian musuh alami, pengamatan lahan mingguan, dan petani sebagai ahli di lahannya sendiri. Semprotan pestisida adalah pilihan terakhir, bukan jadwal rutin.","Musuh alami seperti laba-laba, capung, dan parasitoid telur bekerja gratis setiap hari. Penyemprotan berlebihan justru membunuh mereka dan memicu ledakan hama (resurjensi), terutama wereng cokelat."]],
          ["Pengamatan dan Ambang Kendali",["Amati 10–20 rumpun contoh secara diagonal setiap minggu. Contoh ambang kendali: wereng batang cokelat ±10 ekor per rumpun pada tanaman muda; penggerek batang bila kelompok telur melebihi 1 kelompok per m² pada fase vegetatif. Di bawah ambang, biarkan musuh alami bekerja.","Catat hasil pengamatan sederhana di buku tani: tanggal, umur tanaman, hama yang ditemukan, dan tindakan. Catatan ini membantu keputusan musim berikutnya."]],
          ["Bila Pestisida Memang Diperlukan",["Pilih produk yang terdaftar resmi untuk hama sasaran, baca label, dan jangan pernah mencampur beberapa produk tanpa anjuran. Gunakan dosis label dan hitung kebutuhan per tangki dengan Kalkulator Dosis Pestisida kami. Selalu pakai APD, semprot pagi atau sore saat angin tenang, dan patuhi masa henti sebelum panen."]]
        ],
        refs:["Direktorat Perlindungan Tanaman Pangan, Kementan — Pedoman Pengendalian Hama Terpadu.","FAO — Farmer Field School dan prinsip PHT (diterjemahkan dalam program SL-PHT Indonesia)."] },
      { slug:"teknologi-pertanian-presisi", cat:"Teknologi Pertanian", thumb:"teknologi", title:"Teknologi Pertanian Presisi untuk Petani Kecil: Mulai dari yang Gratis", author:"Tim Vexora", date:"2026-08-26", read:"6 menit baca",
        excerpt:"Pertanian presisi bukan hanya milik perkebunan besar. Dari BWD, aplikasi cuaca, peta lahan di HP, sampai drone — ini tangga teknologi yang realistis untuk petani Indonesia.",
        body:[
          ["Tangga Pertama: Data Sederhana",["Mulai dari mencatat: tanggal tanam, dosis pupuk, biaya, dan hasil per petak. Data sederhana ini — ditambah kalkulator seperti di Petani Bijak Indonesia — sudah mengubah keputusan dari “kira-kira” menjadi terukur.","Bagan Warna Daun (BWD) untuk padi adalah contoh teknologi presisi murah: keputusan pupuk nitrogen berdasarkan kebutuhan nyata tanaman, bukan takaran kebiasaan."]],
          ["Tangga Kedua: HP sebagai Alat Ukur",["HP Android dapat menjadi alat ukur lahan (GPS), kamera diagnostik hama, dan akses informasi harga. Ukur petak Anda lalu verifikasi dengan Kalkulator Luas Lahan kami untuk mendapatkan angka hektare dan rante yang konsisten.","Manfaatkan prakiraan cuaca BMKG untuk menjadwalkan pemupukan dan penyemprotan — pupuk yang diaplikasikan sebelum hujan lebat sebagian besar akan hilang terbawa air."]],
          ["Tangga Ketiga: Layanan Bersama Kelompok Tani",["Drone semprot, alat uji tanah, dan traktor roda empat lebih masuk akal dimiliki melalui kelompok tani, koperasi, atau jasa sewa (UPJA). Biaya per hektare turun, dan teknologi canggih menjadi terjangkau tanpa utang alat."]]
        ],
        refs:["Badan Meteorologi, Klimatologi, dan Geofisika (BMKG) — layanan informasi cuaca pertanian.","Balitbangtan, Kementan — Inovasi teknologi pertanian spesifik lokasi."] },
      { slug:"menghitung-keuntungan-usaha-tani", cat:"Manajemen Usaha Tani", thumb:"usaha", title:"Cara Menghitung Keuntungan Usaha Tani dan Titik Impas (BEP)", author:"Renaldo Sinaga", date:"2026-08-10", read:"6 menit baca",
        excerpt:"Banyak petani panen besar tetapi tidak tahu pasti untung atau rugi. Pelajari cara menyusun biaya produksi, menghitung BEP harga dan BEP volume, dan membaca margin panen Anda.",
        body:[
          ["Susun Dulu Semua Biaya",["Biaya produksi mencakup benih, pupuk, pestisida, tenaga kerja (termasuk tenaga keluarga — beri nilai wajar), pengolahan tanah, transportasi, dan biaya lain seperti irigasi dan karung. Gunakan Kalkulator Biaya Tanam kami agar tidak ada pos yang tertinggal."]],
          ["Rumus Keuntungan dan BEP",["Keuntungan bersih = (total hasil panen × harga jual) − total biaya produksi. Titik impas volume = total biaya ÷ harga jual per kg; titik impas harga = total biaya ÷ total hasil. Selama hasil nyata di atas BEP volume, usaha Anda untung.","Contoh: biaya Rp7.500.000/ha dan harga gabah Rp6.500/kg berarti BEP volume ≈ 1.154 kg. Dengan hasil rata-rata 5.500 kg/ha, ruang aman usaha sangat lebar — tetapi margin menipis cepat bila harga jatuh atau biaya pupuk naik. Simulasikan skenario Anda di Kalkulator Keuntungan Panen."]],

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <style>
      button, [role="button"], select, summary, input:not([type="checkbox"], [type="radio"]) { min-height: 2.25rem; }
      :root{
        --forest:#174B35; --forest-2:#0F3524; --agri:#328653; --agri-dark:#26703F; --lime:#A4C96B; --lime-soft:#DCECC0;
        --cream:#F8F7EF; --paper:#FFFFFF; --ink:#202C24; --ink-soft:#4A5A4E; --line:#E3E6D8;
        --bg:var(--cream); --surface:#FFFFFF; --surface-2:#F1F2E6; --chip:#EDF3E2;
        --shadow:0 10px 30px rgba(23,75,53,.10); --shadow-lg:0 24px 60px rgba(23,75,53,.16);
        --radius:18px; --danger:#B3402A; --warn-bg:#FBF3DC; --warn-ink:#7A5B12;
      }
      html[data-theme="dark"]{
        --bg:#10190F; --surface:#182619; --surface-2:#1E2F1D; --chip:#22351F; --paper:#182619;
        --ink:#EDF3E4; --ink-soft:#B9C8B2; --line:#2C4229; --cream:#10190F;
        --shadow:0 10px 30px rgba(0,0,0,.35); --shadow-lg:0 24px 60px rgba(0,0,0,.5);
        --warn-bg:#3A3013; --warn-ink:#EFD489;
      }
      *{box-sizing:border-box}
      html{scroll-behavior:smooth}
      body{margin:0;font-family:"Plus Jakarta Sans",system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
      img,svg{display:block;max-width:100%}
      a{color:var(--agri);text-decoration:none}
      a:hover{text-decoration:underline}
      button{font-family:inherit;cursor:pointer}
      :focus-visible{outline:3px solid var(--lime);outline-offset:2px;border-radius:6px}
      .wrap{max-width:1200px;margin:0 auto;padding:0 20px}
      h1,h2,h3{line-height:1.2;margin:0}
      .serif{font-family:"Fraunces",serif}

      /* ---------- Header ---------- */
      header.site{position:sticky;top:0;z-index:60;background:color-mix(in srgb, var(--bg) 88%, transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
      .nav{display:flex;align-items:center;gap:18px;padding:12px 0}
      .brand{display:flex;align-items:center;gap:11px;color:var(--ink);flex-shrink:0}
      .brand:hover{text-decoration:none}
      .brand .logo-badge{width:44px;height:44px;border-radius:13px;background:linear-gradient(145deg,var(--forest),var(--agri));display:grid;place-items:center;box-shadow:var(--shadow)}
      .brand b{font-size:1.02rem;letter-spacing:-.01em;display:block;line-height:1.1}
      .brand small{color:var(--agri);font-weight:700;font-size:.68rem;letter-spacing:.08em;text-transform:uppercase}
      nav.main{display:flex;gap:4px;margin-left:auto}
      nav.main a{color:var(--ink);font-weight:600;font-size:.93rem;padding:9px 13px;border-radius:10px;min-height:36px;display:inline-flex;align-items:center}
      nav.main a:hover{background:var(--chip);text-decoration:none}
      nav.main a.active{background:var(--forest);color:#fff}
      .nav-actions{display:flex;gap:8px;align-items:center}
      .icon-btn{width:40px;height:40px;border-radius:11px;border:1px solid var(--line);background:var(--surface);display:grid;place-items:center;color:var(--ink)}
      .icon-btn:hover{border-color:var(--lime)}
      .burger{display:none}
      .mobile-menu{display:none;border-top:1px solid var(--line);padding:10px 0 16px}
      .mobile-menu.open{display:block}
      .mobile-menu a{display:block;padding:11px 6px;font-weight:600;color:var(--ink);border-bottom:1px solid var(--line)}
      .mobile-menu a:last-child{border-bottom:0}

      /* ---------- Buttons ---------- */
      .btn{display:inline-flex;align-items:center;gap:8px;border:0;border-radius:12px;padding:12px 22px;font-weight:700;font-size:.95rem;min-height:46px;transition:transform .15s ease, box-shadow .15s ease}
      .btn:hover{text-decoration:none}
      .btn-primary{background:var(--forest);color:#fff;box-shadow:0 8px 20px rgba(23,75,53,.28)}
      .btn-primary:hover{background:var(--forest-2);transform:translateY(-1px)}
      .btn-lime{background:var(--lime);color:var(--forest-2)}
      .btn-lime:hover{transform:translateY(-1px)}
      .btn-ghost{background:var(--surface);color:var(--ink);border:1.5px solid var(--line)}
      .btn-ghost:hover{border-color:var(--agri)}
      .btn-sm{padding:8px 16px;min-height:38px;font-size:.87rem;border-radius:10px}
      .btn-block{width:100%;justify-content:center}

      /* ---------- Hero ---------- */
      .hero{padding:56px 0 30px;position:relative;overflow:hidden}
      .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:44px;align-items:center}
      .pill{display:inline-flex;align-items:center;gap:8px;background:var(--chip);color:var(--forest);font-weight:700;font-size:.78rem;padding:7px 14px;border-radius:99px;letter-spacing:.02em}
      html[data-theme="dark"] .pill{color:var(--lime)}
      .pill .dot{width:8px;height:8px;border-radius:50%;background:var(--agri)}
      .hero h1{font-size:clamp(2.1rem,4.6vw,3.4rem);font-weight:800;letter-spacing:-.02em;margin:18px 0 16px}
      .hero h1 em{font-family:"Fraunces",serif;font-style:italic;font-weight:600;color:var(--agri)}
      .hero p.lead{font-size:1.08rem;color:var(--ink-soft);max-width:34rem;margin:0 0 26px}
      .searchbar{display:flex;background:var(--surface);border:1.5px solid var(--line);border-radius:16px;padding:6px;box-shadow:var(--shadow);max-width:34rem;position:relative}
      .searchbar input{flex:1;border:0;background:transparent;padding:10px 12px;font:inherit;font-size:.97rem;color:var(--ink);min-width:0}
      .searchbar input:focus{outline:none}
      .search-results{position:absolute;top:calc(100% + 8px);left:0;right:0;background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow-lg);overflow:hidden;z-index:30}
      .search-results a{display:flex;gap:10px;align-items:center;padding:12px 16px;color:var(--ink);font-weight:600;font-size:.93rem}
      .search-results a:hover,.search-results a:focus{background:var(--chip);text-decoration:none}
      .search-results .none{padding:14px 16px;color:var(--ink-soft);font-size:.9rem}
      .hero-cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}
      .hero-art{position:relative}
      .hero-art .art-card{background:var(--surface);border:1px solid var(--line);border-radius:26px;padding:14px;box-shadow:var(--shadow-lg)}
      .float-chip{position:absolute;display:flex;align-items:center;gap:9px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:9px 14px;box-shadow:var(--shadow);font-size:.8rem;font-weight:700}
      .float-chip small{display:block;font-weight:500;color:var(--ink-soft);font-size:.7rem}
      .chip-a{top:16px;left:-14px}.chip-b{bottom:20px;right:-8px}
      .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:44px 0 6px}
      .stat{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:18px 20px}
      .stat b{font-size:1.55rem;font-weight:800;color:var(--forest);display:block;letter-spacing:-.02em}
      html[data-theme="dark"] .stat b{color:var(--lime)}
      .stat span{color:var(--ink-soft);font-size:.85rem;font-weight:600}

      /* ---------- Sections ---------- */
      section.block{padding:52px 0 8px}
      .sec-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap}
      .sec-head h2{font-size:clamp(1.5rem,3vw,2rem);font-weight:800;letter-spacing:-.02em}
      .sec-head p{color:var(--ink-soft);margin:6px 0 0;max-width:36rem}
      .kicker{color:var(--agri);font-weight:800;font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;margin-bottom:8px}

      .cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
      .cat-card{display:flex;gap:15px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:18px;color:var(--ink);transition:transform .18s ease, box-shadow .18s ease;text-align:left;width:100%;font:inherit}
      .cat-card:hover{transform:translateY(-3px);box-shadow:var(--shadow);text-decoration:none}
      .cat-ic{width:52px;height:52px;flex-shrink:0;border-radius:14px;display:grid;place-items:center;background:var(--chip)}
      .cat-card b{display:block;font-size:1rem}
      .cat-card span{color:var(--ink-soft);font-size:.86rem}

      .tool-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
      .tool-card{background:var(--surface);border:1px solid var(--line);border-radius:22px;overflow:hidden;display:flex;flex-direction:column;transition:transform .18s ease, box-shadow .18s ease}
      .tool-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
      .tool-art{aspect-ratio:400/215;background:var(--surface-2);border-bottom:1px solid var(--line)}
      .tool-art svg{width:100%;height:100%}
      .tool-body{padding:20px;display:flex;flex-direction:column;gap:8px;flex:1}
      .tool-body .tag{align-self:flex-start;background:var(--chip);color:var(--forest);font-size:.7rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:4px 10px;border-radius:99px}
      html[data-theme="dark"] .tool-body .tag{color:var(--lime)}
      .tool-body h3{font-size:1.08rem;font-weight:800}
      .tool-body p{color:var(--ink-soft);font-size:.9rem;margin:0;flex:1}
      .tool-foot{display:flex;align-items:center;justify-content:space-between;margin-top:8px}
      .tool-foot .free{font-size:.8rem;font-weight:700;color:var(--agri)}

      /* ---------- Calculator ---------- */
      .crumb{font-size:.85rem;color:var(--ink-soft);margin:26px 0 4px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
      .crumb a{font-weight:600}
      .calc-head{display:grid;grid-template-columns:1fr 340px;gap:26px;align-items:center;margin:14px 0 26px}
      .calc-head h1{font-size:clamp(1.7rem,3.4vw,2.4rem);font-weight:800;letter-spacing:-.02em}
      .calc-head p{color:var(--ink-soft);margin:10px 0 0;max-width:38rem}
      .calc-head .art{background:var(--surface);border:1px solid var(--line);border-radius:22px;overflow:hidden;box-shadow:var(--shadow)}
      .calc-layout{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start;padding-bottom:20px}
      .panel{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:24px}
      .panel h2{font-size:1.05rem;font-weight:800;margin-bottom:4px}
      .panel .sub{color:var(--ink-soft);font-size:.87rem;margin:0 0 18px}
      .field{margin-bottom:15px}
      .field label{display:block;font-weight:700;font-size:.88rem;margin-bottom:6px}
      .field .hint{font-weight:500;color:var(--ink-soft);font-size:.78rem;margin-top:5px}
      .field input,.field select{width:100%;border:1.5px solid var(--line);border-radius:11px;padding:11px 13px;font:inherit;font-size:.95rem;background:var(--surface);color:var(--ink)}
      .field input:focus,.field select:focus{border-color:var(--agri);outline:none;box-shadow:0 0 0 3px color-mix(in srgb, var(--lime) 35%, transparent)}
      .field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
      .field .err{color:var(--danger);font-size:.8rem;font-weight:600;margin-top:5px;display:none}
      .field.invalid input,.field.invalid select{border-color:var(--danger)}
      .field.invalid .err{display:block}
      .seg{display:flex;gap:8px;flex-wrap:wrap}
      .seg button{border:1.5px solid var(--line);background:var(--surface);color:var(--ink);border-radius:11px;padding:9px 15px;font-weight:700;font-size:.88rem;min-height:40px}
      .seg button.on{background:var(--forest);color:#fff;border-color:var(--forest)}
      .result-empty{color:var(--ink-soft);text-align:center;padding:34px 10px}
      .result-empty .big{font-size:2rem;margin-bottom:6px}
      .res-highlight{background:linear-gradient(145deg,var(--forest),var(--agri));color:#fff;border-radius:16px;padding:20px;margin-bottom:16px}
      .res-highlight small{opacity:.85;font-weight:600;font-size:.8rem;letter-spacing:.04em;text-transform:uppercase}
      .res-highlight .val{font-size:2rem;font-weight:800;letter-spacing:-.02em;line-height:1.15}
      .res-highlight .val2{font-size:.95rem;opacity:.92}
      .res-rows{display:flex;flex-direction:column}
      .res-row{display:flex;justify-content:space-between;gap:16px;padding:11px 2px;border-bottom:1px dashed var(--line);font-size:.93rem}
      .res-row:last-child{border-bottom:0}
      .res-row span{color:var(--ink-soft)}
      .res-row b{text-align:right;font-weight:700}
      .res-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:18px}
      .note-box{border-radius:14px;padding:14px 16px;font-size:.87rem;margin-top:16px}
      .note-info{background:var(--chip);color:var(--ink)}
      .note-warn{background:var(--warn-bg);color:var(--warn-ink)}
      .note-box b{display:block;margin-bottom:3px}
      .chart-box{margin-top:16px}
      .history{margin-top:22px}
      .history h3{font-size:.95rem;font-weight:800;margin-bottom:10px}
      .hist-item{display:flex;justify-content:space-between;gap:12px;background:var(--surface-2);border-radius:12px;padding:11px 14px;font-size:.86rem;margin-bottom:8px}
      .hist-item b{display:block;font-size:.88rem}
      .hist-item span{color:var(--ink-soft)}
      .hist-item time{color:var(--ink-soft);font-size:.76rem;white-space:nowrap}

      /* ---------- Articles ---------- */
      .filter-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px}
      .filter-row button{border:1.5px solid var(--line);background:var(--surface);color:var(--ink);border-radius:99px;padding:8px 16px;font-weight:700;font-size:.85rem;min-height:38px}
      .filter-row button.on{background:var(--forest);color:#fff;border-color:var(--forest)}
      .art-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
      .art-card{background:var(--surface);border:1px solid var(--line);border-radius:22px;overflow:hidden;display:flex;flex-direction:column;color:var(--ink);transition:transform .18s ease, box-shadow .18s ease}
      .art-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);text-decoration:none}
      .art-thumb{aspect-ratio:16/9;position:relative;overflow:hidden}
      .art-thumb svg{width:100%;height:100%}
      .art-body{padding:19px;display:flex;flex-direction:column;gap:7px;flex:1}
      .art-body .meta{font-size:.76rem;font-weight:700;color:var(--agri);letter-spacing:.05em;text-transform:uppercase}
      .art-body h3{font-size:1.05rem;font-weight:800;line-height:1.35}
      .art-body p{color:var(--ink-soft);font-size:.88rem;margin:0;flex:1}
      .art-body .byline{font-size:.8rem;color:var(--ink-soft)}
      .article-wrap{max-width:780px;margin:0 auto;padding-bottom:10px}
      .article-wrap h1{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:800;letter-spacing:-.02em;margin:10px 0 12px}
      .article-hero{border-radius:22px;overflow:hidden;border:1px solid var(--line);margin:20px 0}
      .article-hero svg{width:100%;height:auto}
      .toc{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:18px 22px;margin:0 0 26px}
      .toc b{display:block;margin-bottom:8px}
      .toc ol{margin:0;padding-left:20px}
      .toc li{margin:4px 0}
      .article-body h2{font-size:1.35rem;font-weight:800;margin:30px 0 10px}
      .article-body p{margin:0 0 14px;color:var(--ink)}
      .article-body ul{margin:0 0 14px;padding-left:20px}
      .article-body li{margin:5px 0}
      .refs{background:var(--surface-2);border-radius:16px;padding:18px 22px;font-size:.88rem;margin-top:28px}
      .refs b{display:block;margin-bottom:6px}
      .refs ul{margin:0;padding-left:18px}

      /* ---------- Pages ---------- */
      .page-wrap{max-width:820px;margin:0 auto;padding-bottom:10px}
      .page-wrap h1{font-size:clamp(1.8rem,4vw,2.5rem);font-weight:800;letter-spacing:-.02em;margin:8px 0 14px}
      .page-wrap h2{font-size:1.25rem;font-weight:800;margin:28px 0 9px}
      .page-wrap p{margin:0 0 13px}
      .page-wrap ul{margin:0 0 13px;padding-left:20px}
      .page-wrap li{margin:5px 0}
      .team-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:22px 0}
      .team-card{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:24px}
      .avatar{width:60px;height:60px;border-radius:50%;background:linear-gradient(145deg,var(--agri),var(--lime));display:grid;place-items:center;color:#fff;font-weight:800;font-size:1.25rem;margin-bottom:12px}
      .contact-card{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:26px;display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin:20px 0}
      .ad-slot{border:1.5px dashed var(--line);border-radius:16px;color:var(--ink-soft);text-align:center;padding:20px;font-size:.82rem;font-weight:600;margin:34px 0 6px;background:var(--surface)}

      /* ---------- Footer ---------- */
      footer.site{background:var(--forest-2);color:#DCE8D2;margin-top:70px}
      html[data-theme="dark"] footer.site{background:#0B1F14}
      .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:30px;padding:48px 0 34px}
      footer.site h4{color:#fff;font-size:.95rem;margin:0 0 13px}
      footer.site a{color:#C9DCC0;display:block;padding:5px 0;font-size:.9rem}
      footer.site a:hover{color:#fff}
      footer.site p{font-size:.9rem;margin:0 0 10px}
      .foot-bottom{border-top:1px solid rgba(255,255,255,.14);padding:18px 0 24px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:.84rem}

      .toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,80px);background:var(--forest);color:#fff;padding:13px 22px;border-radius:13px;font-weight:700;font-size:.9rem;box-shadow:var(--shadow-lg);z-index:100;transition:transform .3s ease, opacity .3s ease, visibility .3s;max-width:92vw;text-align:center;opacity:0;visibility:hidden;pointer-events:none}
      .toast.show{transform:translate(-50%,0);opacity:1;visibility:visible}
      .view{display:none}
      .view.active{display:block}
      .how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
      .how-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:22px}
      .how-card .num{width:38px;height:38px;border-radius:50%;background:var(--forest);color:#fff;display:grid;place-items:center;font-weight:800;margin-bottom:12px}
      .how-card h3{font-size:1rem;font-weight:800;margin-bottom:6px}
      .how-card p{color:var(--ink-soft);font-size:.9rem;margin:0}

      @media (max-width:1020px){
        .tool-grid,.art-grid,.cat-grid{grid-template-columns:repeat(2,1fr)}
        .hero-grid{grid-template-columns:1fr;gap:30px}
        .calc-head{grid-template-columns:1fr}
        .calc-head .art{max-width:460px}
        .foot-grid{grid-template-columns:1fr 1fr}
      }
      @media (max-width:760px){
        nav.main{display:none}
        .burger{display:grid}
        .nav{gap:10px}
        .brand{gap:9px;min-width:0}
        .brand .logo-badge{width:38px;height:38px;border-radius:11px}
        .brand b{font-size:.9rem;white-space:nowrap}
        .brand small{display:none}
        .nav-actions{gap:6px;margin-left:auto}
        .icon-btn{width:38px;height:38px;border-radius:10px}
        .tool-grid,.art-grid,.cat-grid,.how-grid{grid-template-columns:1fr}
        .calc-layout{grid-template-columns:1fr}
        .stats{grid-template-columns:repeat(2,1fr)}
        .team-grid{grid-template-columns:1fr}
        .field-row{grid-template-columns:1fr}
        .chip-a{left:2px}.chip-b{right:2px}
        .hero{padding-top:36px}

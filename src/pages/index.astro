    <div class="toast" id="toast" role="status"></div>
    <script>
    "use strict";
    /* ============================================================
       PETANI BIJAK INDONESIA — aplikasi client-side
       Output statis (SSG) bergaya Astro: seluruh kalkulator berjalan
       di browser sebagai client script/island, tanpa backend wajib.
       ============================================================ */
    const $ = (s, r) => (r||document).querySelector(s);
    const $$ = (s, r) => Array.from((r||document).querySelectorAll(s));
    const fmtIDR = n => "Rp " + Math.round(n).toLocaleString("id-ID");
    const fmtNum = (n, d=2) => Number(n).toLocaleString("id-ID",{minimumFractionDigits:0, maximumFractionDigits:d});
    function parseNum(v){ if(v===null||v===undefined) return NaN; const s=String(v).trim().replace(/\./g,"").replace(",","."); const plain=String(v).trim().replace(",","."); const n = /^-?\d{1,3}(\.\d{3})+(,\d+)?$/.test(String(v).trim()) ? parseFloat(s) : parseFloat(plain); return n; }
    function toast(msg){ const t=$("#toast"); t.textContent=msg; t.classList.add("show"); clearTimeout(t._h); t._h=setTimeout(()=>t.classList.remove("show"),2600); }

    /* ---------------- Ilustrasi SVG unik per tool ---------------- */
    const PAL = {sky:"#EAF3DC", sky2:"#F4F8E9", hill:"#B9D98F", hill2:"#8FC16A", field:"#5FA85C", field2:"#3E8E4F", soil:"#8A6642", soilD:"#6E4F30", gold:"#E9C46A", goldD:"#D9A441", cream:"#FBF7E8", red:"#C4552E", teal:"#2E7D6B"};
    function svgWrap(inner, bg){ return `<svg viewBox="0 0 400 215" role="img" aria-hidden="true" preserveAspectRatio="xMidYMid slice"><rect width="400" height="215" fill="${bg||PAL.sky2}"/>${inner}</svg>`; }
    const sun = (x,y,r)=>`<circle cx="${x}" cy="${y}" r="${r}" fill="${PAL.gold}" opacity=".85"/>`;
    const ILLUS = {
      hero(){ return svgWrap(`
        ${sun(322,42,26)}
        <path d="M0 92 Q90 60 190 84 T400 74 V215 H0Z" fill="${PAL.hill}"/>
        <path d="M0 122 Q110 92 215 114 T400 106 V215 H0Z" fill="${PAL.hill2}"/>
        <path d="M0 150 Q120 128 230 146 T400 140 V215 H0Z" fill="${PAL.field}"/>
        ${[0,1,2,3,4].map(i=>`<path d="M${18+i*6} ${168+i*9} Q200 ${150+i*9} 382 ${162+i*9}" stroke="${PAL.field2}" stroke-width="3" fill="none" opacity=".55"/>`).join("")}
        <g stroke="${PAL.field2}" stroke-width="2.4" stroke-linecap="round">${[60,110,160,255,305,350].map(x=>`<path d="M${x} 196 v-13 M${x} 183 q-7-8-13-8 M${x} 183 q7-8 13-8" fill="none"/>`).join("")}</g>
        <g><rect x="238" y="52" width="86" height="58" rx="9" fill="#fff" stroke="${PAL.teal}" stroke-width="2"/><path d="M250 96 l14-16 12 10 16-20" stroke="${PAL.red}" stroke-width="3" fill="none" stroke-linecap="round"/><circle cx="250" cy="96" r="3" fill="${PAL.teal}"/><circle cx="264" cy="80" r="3" fill="${PAL.teal}"/><circle cx="276" cy="90" r="3" fill="${PAL.teal}"/><circle cx="292" cy="70" r="3" fill="${PAL.teal}"/><path d="M238 66 L180 128" stroke="${PAL.teal}" stroke-width="2" stroke-dasharray="5 5" opacity=".6"/></g>
        <g><circle cx="168" cy="112" r="10" fill="${PAL.soilD}"/><path d="M158 104 q10-10 20 0 l-3-9 q-7-4-14 0Z" fill="${PAL.goldD}"/><path d="M154 128 q14-8 28 0 l4 34 h-36Z" fill="${PAL.teal}"/><path d="M182 130 q14 4 20 16" stroke="${PAL.soilD}" stroke-width="6" fill="none" stroke-linecap="round"/><rect x="196" y="140" width="20" height="27" rx="3" fill="#174B35" transform="rotate(18 206 153)"/><rect x="200" y="144" width="12" height="16" rx="1.5" fill="${PAL.lime||'#A4C96B'}" transform="rotate(18 206 153)" opacity=".9"/></g>
        <g stroke="${PAL.field2}" stroke-width="2.6" stroke-linecap="round"><path d="M196 176 v-16 M196 162 q-8-9-15-9 M196 162 q8-9 15-9 M196 168 q-9-5-16-3 M196 168 q9-5 16-3" fill="none"/></g>
        <g opacity=".9"><rect x="52" y="40" width="34" height="22" rx="4" fill="#174B35"/><path d="M58 56 l7-8 6 5 8-9" stroke="${PAL.gold}" stroke-width="2.4" fill="none"/></g>
      `, "#EFF6E0"); },
      benih(){ return svgWrap(`
        ${sun(52,40,20)}
        <path d="M0 168 Q200 148 400 168 V215 H0Z" fill="${PAL.soil}"/>
        <path d="M0 168 Q200 148 400 168" stroke="${PAL.soilD}" stroke-width="4" fill="none"/>
        <g stroke="${PAL.field2}" stroke-width="3" stroke-linecap="round"><path d="M200 168 v-34 M200 142 q-16-16-30-15 M200 142 q16-16 30-15 M200 152 q-13-8-24-6 M200 152 q13-8 24-6" fill="none"/></g>
        <g><path d="M96 92 q4 34-6 62" stroke="${PAL.goldD}" stroke-width="3.4" fill="none"/>${[0,1,2,3,4,5].map(i=>`<ellipse cx="${88-(i%2)*10}" cy="${98+i*10}" rx="6" ry="10" fill="${PAL.gold}" transform="rotate(${-28-(i%2)*8} ${88-(i%2)*10} ${98+i*10})"/><ellipse cx="${104+(i%2)*9}" cy="${100+i*10}" rx="6" ry="10" fill="${PAL.gold}" transform="rotate(${26+(i%2)*8} ${104+(i%2)*9} ${100+i*10})"/>`).join("")}</g>
        <g><path d="M302 92 q-4 34 6 62" stroke="${PAL.goldD}" stroke-width="3.4" fill="none"/>${[0,1,2,3,4,5].map(i=>`<ellipse cx="${310+(i%2)*10}" cy="${98+i*10}" rx="6" ry="10" fill="${PAL.gold}" transform="rotate(${28+(i%2)*8} ${310+(i%2)*10} ${98+i*10})"/><ellipse cx="${294-(i%2)*9}" cy="${100+i*10}" rx="6" ry="10" fill="${PAL.gold}" transform="rotate(${-26-(i%2)*8} ${294-(i%2)*9} ${100+i*10})"/>`).join("")}</g>
        <g fill="#F6E3B4" stroke="${PAL.goldD}" stroke-width="1.4">${[[150,182],[176,190],[228,186],[256,192],[200,196],[120,192],[282,182]].map(p=>`<ellipse cx="${p[0]}" cy="${p[1]}" rx="8" ry="4.6" transform="rotate(-18 ${p[0]} ${p[1]})"/>`).join("")}</g>
        <path d="M132 178 q68-14 136 0" stroke="#fff" stroke-width="2" stroke-dasharray="4 6" fill="none" opacity=".5"/>
      `); },
      pupuk(){ return svgWrap(`
        ${sun(348,38,20)}
        <path d="M0 150 H400 V215 H0Z" fill="${PAL.soil}"/>
        <path d="M0 150 H400" stroke="${PAL.soilD}" stroke-width="4"/>
        <g><path d="M62 62 h74 l8 88 H54Z" fill="${PAL.cream}" stroke="${PAL.goldD}" stroke-width="2.5"/><path d="M62 62 h74 l3 20 H59Z" fill="${PAL.gold}"/><circle cx="99" cy="112" r="17" fill="none" stroke="${PAL.field2}" stroke-width="2.6"/><path d="M99 124 v-16 M99 112 q-9-8-15-7 M99 112 q9-8 15-7" stroke="${PAL.field2}" stroke-width="2.6" fill="none" stroke-linecap="round"/><g fill="#fff" stroke="#C9CFD2" stroke-width="1.2">${[[150,140],[164,148],[142,150]].map(p=>`<circle cx="${p[0]}" cy="${p[1]}" r="5.5"/>`).join("")}</g></g>
        <g stroke="${PAL.field2}" stroke-width="3.2" stroke-linecap="round"><path d="M268 150 v-52 M268 108 q-20-20-36-18 M268 108 q20-20 36-18 M268 124 q-15-10-28-8 M268 124 q15-10 28-8" fill="none"/></g>
        <path d="M268 150 q-3 22-14 34 M268 150 q0 26-2 40 M268 150 q4 22 15 33" stroke="#D9B98A" stroke-width="3" fill="none" stroke-linecap="round"/>
        <g fill="${PAL.hill2}">${[[216,66],[322,58],[288,44]].map(p=>`<path d="M${p[0]} ${p[1]} q5-12 12-14 q0 12-6 17 q-6 3-12-3Z"/>`).join("")}</g>
        <g fill="#fff" opacity=".95">${[[196,138],[206,146],[188,148]].map(p=>`<circle cx="${p[0]}" cy="${p[1]}" r="4.4"/>`).join("")}</g>
      `); },
      luas(){ return svgWrap(`
        <g transform="translate(30,18)">
          <polygon points="60,150 200,88 340,150 200,196" fill="${PAL.field}" stroke="#fff" stroke-width="2.5"/>
          <polygon points="60,150 200,88 200,196" fill="${PAL.hill2}" opacity=".65"/>
          <polygon points="200,88 340,150 200,196" fill="${PAL.field2}" opacity=".5"/>
          <path d="M110 127 L290 127 M130 108 L250 158 M250 108 L130 158" stroke="#fff" stroke-width="1.6" stroke-dasharray="6 5" opacity=".75"/>
          <path d="M60 162 L340 162" stroke="${PAL.red}" stroke-width="2.6"/><path d="M60 156 v12 M340 156 v12" stroke="${PAL.red}" stroke-width="2.6"/>
          <path d="M48 88 h284" stroke="${PAL.teal}" stroke-width="2.4" stroke-dasharray="3 6"/>
          <g><path d="M200 30 c-12 0-19 8-19 17 0 12 19 27 19 27 s19-15 19-27 c0-9-7-17-19-17Z" fill="${PAL.red}"/><circle cx="200" cy="47" r="7" fill="#fff"/></g>
          <g fill="${PAL.goldD}"><rect x="52" y="140" width="9" height="9"/><rect x="332" y="140" width="9" height="9"/><rect x="196" y="78" width="9" height="9"/></g>
